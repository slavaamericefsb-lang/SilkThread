<Application x:Class="SilkThread.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0D0E15"/>
        <SolidColorBrush x:Key="CardDark" Color="#151722"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A2D3D"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="BrandPurpleHover" Color="#7C3AED"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>

        <!-- Custom ScrollBar & Controls Styling if needed -->
    </Application.Resources>
</Application>
