<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="SilkThread.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SilkThread.App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/SilkStyles.xaml" />
                <ResourceDictionary Source="Styles/SilkScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#806BFF</Color>
            <Color x:Key="SystemAccentColorLight1">#9787FF</Color>
            <Color x:Key="SystemAccentColorLight2">#806BFF</Color>
            <Color x:Key="SystemAccentColorLight3">#B7ACFF</Color>
            <Color x:Key="SystemAccentColorDark1">#806BFF</Color>
            <Color x:Key="SystemAccentColorDark2">#6D55FA</Color>
            <Color x:Key="SystemAccentColorDark3">#5842D4</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
