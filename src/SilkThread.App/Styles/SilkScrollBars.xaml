<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native ScrollBar parts retain dragging, paging, keyboard and automation support. -->
    <ControlTemplate x:Key="SilkScrollPageTemplate" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    <ControlTemplate x:Key="SilkScrollThumbTemplate" TargetType="Thumb">
        <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="4" Margin="3">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource SilkBrandHoverBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource SilkBrandBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Grip.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.14"/></Border.BackgroundTransition>
        </Border>
    </ControlTemplate>
    <Style x:Key="SilkScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="14"/><Setter Property="MinHeight" Value="14"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Grid x:Name="VerticalRoot" Width="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.RowSpan="5" Background="#202532" CornerRadius="4" Margin="3"/>
                    <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <Thumb x:Name="VerticalThumb" Grid.Row="2" MinHeight="32" Width="14" Background="#8874D6" Template="{StaticResource SilkScrollThumbTemplate}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <Grid x:Name="HorizontalRoot" Height="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="5" Background="#202532" CornerRadius="4" Margin="3"/>
                    <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Template="{StaticResource SilkScrollPageTemplate}"/>
                    <Thumb x:Name="HorizontalThumb" Grid.Column="2" MinWidth="32" Height="14" Background="#8874D6" Template="{StaticResource SilkScrollThumbTemplate}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SilkScrollBarStyle}"/>
</ResourceDictionary>
