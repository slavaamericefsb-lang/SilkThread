<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SilkThread.App.Converters">

    <!-- ========================================================================= -->
    <!-- Value Converters                                                          -->
    <!-- ========================================================================= -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    <converters:RiskToColorConverter x:Key="RiskToColorConverter" />
    <converters:RecommendationToColorConverter x:Key="RecommendationToColorConverter" />
    <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
    <converters:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter" />
    <converters:StatusToBorderConverter x:Key="StatusToBorderConverter" />
    <converters:StatusToIconConverter x:Key="StatusToIconConverter" />
    <converters:LocalizedCategoryConverter x:Key="LocalizedCategoryConverter" />
    <converters:CategoryToIconConverter x:Key="CategoryToIconConverter" />
    <converters:LocalizedRiskConverter x:Key="LocalizedRiskConverter" />
    <converters:LocalizedRecommendationConverter x:Key="LocalizedRecommendationConverter" />
    <converters:LocalizedStatusConverter x:Key="LocalizedStatusConverter" />
    <converters:ActionTextConverter x:Key="ActionTextConverter" />
    <converters:BoolToFilterBgConverter x:Key="BoolToFilterBgConverter" />
    <converters:BoolToFilterFgConverter x:Key="BoolToFilterFgConverter" />
    <converters:BoolToCardBgConverter x:Key="BoolToCardBgConverter" />
    <converters:BoolToCardBorderConverter x:Key="BoolToCardBorderConverter" />
    <converters:BoolToStatusBgConverter x:Key="BoolToStatusBgConverter" />
    <converters:BoolToStatusBorderConverter x:Key="BoolToStatusBorderConverter" />
    <converters:BoolToStatusFgConverter x:Key="BoolToStatusFgConverter" />
    <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
    <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    <converters:BoolToCopyBtnTextConverter x:Key="BoolToCopyBtnTextConverter" />
    <converters:BoolToElevationConverter x:Key="BoolToElevationConverter" />
    <converters:BoolToGlowOpacityConverter x:Key="BoolToGlowOpacityConverter" />

    <!-- ========================================================================= -->
    <!-- SilkThread Tech — graphite, luminous violet and layered materials                                             -->
    <!-- ========================================================================= -->

    <!-- Base Colors -->
    <!-- Основной фон: #0B0D12 -->
    <Color x:Key="SilkBackgroundDarkColor">#0B0D12</Color>
    <Color x:Key="SilkSurfaceDarkColor">#0B0D12</Color>

    <!-- Фон боковой панели: #10131B -->
    <Color x:Key="SilkSidebarDarkColor">#10131B</Color>

    <!-- Фон карточек: #171B25 -->
    <Color x:Key="SilkCardDarkColor">#171B25</Color>
    <Color x:Key="SilkCardHoverColor">#202532</Color>

    <!-- Поверхности второго уровня (subsurfaces/tiles): #202532 -->
    <Color x:Key="SilkSubsurfaceDarkColor">#202532</Color>
    <Color x:Key="SilkSubsurfaceHoverColor">#30364A</Color>

    <!-- Границы: #30364A -->
    <Color x:Key="SilkStrokeDarkColor">#30364A</Color>
    <Color x:Key="SilkStrokeHoverColor">#514A70</Color>

    <!-- Основной акцент: #806BFF, Hover: #9787FF, Pressed: #6D55FA -->
    <Color x:Key="SilkBrandPrimaryColor">#806BFF</Color>
    <Color x:Key="SilkBrandHoverColor">#9787FF</Color>
    <Color x:Key="SilkBrandPressedColor">#6D55FA</Color>

    <!-- Акцент с прозрачностью (selection/glow): #26806BFF / #1A806BFF / #22806BFF -->
    <Color x:Key="SilkBrandGlowColor">#26806BFF</Color>
    <Color x:Key="SilkBrandSelectionColor">#22806BFF</Color>
    <Color x:Key="SilkBrandMutedColor">#1A806BFF</Color>

    <!-- Текст: Основной #F5F6FA, Вторичный #ADB5C6, Приглушенный #8892A6 -->
    <Color x:Key="SilkTextPrimaryColor">#F5F6FA</Color>
    <Color x:Key="SilkTextSecondaryColor">#ADB5C6</Color>
    <Color x:Key="SilkTextMutedColor">#8892A6</Color>

    <!-- Статусы: Успех #22C55E, Ошибка #EF4444, Предупреждение #F59E0B -->
    <Color x:Key="SilkSuccessColor">#22C55E</Color>
    <Color x:Key="SilkSuccessBgColor">#1A22C55E</Color>
    <Color x:Key="SilkEmeraldColor">#22C55E</Color>

    <Color x:Key="SilkErrorColor">#EF4444</Color>
    <Color x:Key="SilkErrorBgColor">#1AEF4444</Color>
    <Color x:Key="SilkRoseColor">#EF4444</Color>

    <Color x:Key="SilkWarningColor">#F59E0B</Color>
    <Color x:Key="SilkWarningBgColor">#1AF59E0B</Color>
    <Color x:Key="SilkAmberColor">#F59E0B</Color>

    <!-- Дополнительные инфо-акценты -->
    <Color x:Key="SilkCyanColor">#06B6D4</Color>
    <Color x:Key="SilkSkyColor">#38BDF8</Color>

    <!-- Legacy Aliases for backwards compatibility -->
    <Color x:Key="SilkAmethystPrimaryColor">#806BFF</Color>
    <Color x:Key="SilkAmethystHoverColor">#9787FF</Color>
    <Color x:Key="SilkAmethystPressedColor">#6D55FA</Color>

    <!-- ========================================================================= -->
    <!-- SolidColorBrushes                                                         -->
    <!-- ========================================================================= -->

    <!-- Surfaces & Layout -->
    <SolidColorBrush x:Key="SilkBackgroundDarkBrush" Color="{StaticResource SilkBackgroundDarkColor}" />
    <SolidColorBrush x:Key="SilkSurfaceDarkBrush" Color="{StaticResource SilkSurfaceDarkColor}" />
    <SolidColorBrush x:Key="SilkSidebarDarkBrush" Color="{StaticResource SilkSidebarDarkColor}" />
    <SolidColorBrush x:Key="SilkCardDarkBrush" Color="{StaticResource SilkCardDarkColor}" />
    <SolidColorBrush x:Key="SilkCardHoverBrush" Color="{StaticResource SilkCardHoverColor}" />
    <SolidColorBrush x:Key="SilkSubsurfaceDarkBrush" Color="{StaticResource SilkSubsurfaceDarkColor}" />
    <SolidColorBrush x:Key="SilkSubsurfaceHoverBrush" Color="{StaticResource SilkSubsurfaceHoverColor}" />
    <SolidColorBrush x:Key="SilkStrokeDarkBrush" Color="{StaticResource SilkStrokeDarkColor}" />
    <SolidColorBrush x:Key="SilkStrokeHoverBrush" Color="{StaticResource SilkStrokeHoverColor}" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="SilkBrandBrush" Color="{StaticResource SilkBrandPrimaryColor}" />
    <SolidColorBrush x:Key="SilkBrandHoverBrush" Color="{StaticResource SilkBrandHoverColor}" />
    <SolidColorBrush x:Key="SilkBrandPressedBrush" Color="{StaticResource SilkBrandPressedColor}" />
    <SolidColorBrush x:Key="SilkBrandGlowBrush" Color="{StaticResource SilkBrandGlowColor}" />
    <SolidColorBrush x:Key="SilkBrandSelectionBrush" Color="{StaticResource SilkBrandSelectionColor}" />
    <SolidColorBrush x:Key="SilkBrandMutedBrush" Color="{StaticResource SilkBrandMutedColor}" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="SilkTextPrimaryBrush" Color="{StaticResource SilkTextPrimaryColor}" />
    <SolidColorBrush x:Key="SilkTextSecondaryBrush" Color="{StaticResource SilkTextSecondaryColor}" />
    <SolidColorBrush x:Key="SilkTextMutedBrush" Color="{StaticResource SilkTextMutedColor}" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SilkSuccessBrush" Color="{StaticResource SilkSuccessColor}" />
    <SolidColorBrush x:Key="SilkSuccessBgBrush" Color="{StaticResource SilkSuccessBgColor}" />
    <SolidColorBrush x:Key="SilkEmeraldBrush" Color="{StaticResource SilkSuccessColor}" />
    <SolidColorBrush x:Key="SilkEmeraldBgBrush" Color="{StaticResource SilkSuccessBgColor}" />

    <SolidColorBrush x:Key="SilkErrorBrush" Color="{StaticResource SilkErrorColor}" />
    <SolidColorBrush x:Key="SilkErrorBgBrush" Color="{StaticResource SilkErrorBgColor}" />
    <SolidColorBrush x:Key="SilkRoseBrush" Color="{StaticResource SilkErrorColor}" />
    <SolidColorBrush x:Key="SilkRoseBgBrush" Color="{StaticResource SilkErrorBgColor}" />

    <SolidColorBrush x:Key="SilkWarningBrush" Color="{StaticResource SilkWarningColor}" />
    <SolidColorBrush x:Key="SilkWarningBgBrush" Color="{StaticResource SilkWarningBgColor}" />
    <SolidColorBrush x:Key="SilkAmberBrush" Color="{StaticResource SilkWarningColor}" />
    <SolidColorBrush x:Key="SilkAmberBgBrush" Color="{StaticResource SilkWarningBgColor}" />

    <SolidColorBrush x:Key="SilkCyanBrush" Color="{StaticResource SilkCyanColor}" />
    <SolidColorBrush x:Key="SilkCyanBgBrush" Color="#1A06B6D4" />
    <SolidColorBrush x:Key="SilkSkyBrush" Color="{StaticResource SilkSkyColor}" />
    <SolidColorBrush x:Key="SilkSkyBgBrush" Color="#1A38BDF8" />

    <!-- Minimal Dark UI Component Aliases -->
    <SolidColorBrush x:Key="SilkDarkPageBgBrush" Color="{StaticResource SilkBackgroundDarkColor}" />
    <SolidColorBrush x:Key="SilkDarkCardBgBrush" Color="{StaticResource SilkCardDarkColor}" />
    <SolidColorBrush x:Key="SilkDarkTileBgBrush" Color="{StaticResource SilkSubsurfaceDarkColor}" />
    <SolidColorBrush x:Key="SilkDarkBorderBrush" Color="{StaticResource SilkStrokeDarkColor}" />
    <SolidColorBrush x:Key="SilkDarkAccentBrush" Color="{StaticResource SilkBrandPrimaryColor}" />
    <SolidColorBrush x:Key="SilkDarkTerminalBgBrush" Color="{StaticResource SilkSidebarDarkColor}" />

    <!-- Bento Tile & Gradients -->
    <SolidColorBrush x:Key="SilkBentoGaugeTrackBrush" Color="{StaticResource SilkSubsurfaceDarkColor}" />
    <SolidColorBrush x:Key="SilkBentoTileDarkBrush" Color="{StaticResource SilkSubsurfaceDarkColor}" />
    <SolidColorBrush x:Key="SilkBentoGlassBorderBrush" Color="{StaticResource SilkStrokeDarkColor}" />

    <LinearGradientBrush x:Key="SilkBentoActiveBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#806BFF" Offset="0.0" />
        <GradientStop Color="#9787FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradient1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171B25" Offset="0.0" />
        <GradientStop Color="#171B24" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradient2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171B25" Offset="0.0" />
        <GradientStop Color="#171B24" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradientHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#242137" Offset="0.0" />
        <GradientStop Color="#191C29" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradientHeroV2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#242A38" Offset="0.0" />
        <GradientStop Color="#171B24" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradientAi" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#252039" Offset="0.0" />
        <GradientStop Color="#191C29" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SilkBentoCardGradientOnyx" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171B25" Offset="0.0" />
        <GradientStop Color="#171B24" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ========================================================================= -->
    <!-- Tech materials: restrained graphite depth around a saturated violet focal point. -->
    <LinearGradientBrush x:Key="SilkTechHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#251B3C" Offset="0"/><GradientStop Color="#161725" Offset="0.42"/><GradientStop Color="#10131B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechRailGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171326" Offset="0"/><GradientStop Color="#10131B" Offset="0.6"/><GradientStop Color="#131020" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B08BFF" Offset="0"/><GradientStop Color="#806BFF" Offset="0.48"/><GradientStop Color="#5F3DE1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34204F" Offset="0"/><GradientStop Color="#211B36" Offset="0.46"/><GradientStop Color="#191D2C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechCardGradient" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#202332" Offset="0"/><GradientStop Color="#171B25" Offset="0.6"/><GradientStop Color="#131721" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#49405F" Offset="0"/><GradientStop Color="#30364A" Offset="0.45"/><GradientStop Color="#252B3B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilkTechHeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0"/><GradientStop Color="#655093" Offset="0.4"/><GradientStop Color="#30364A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ScrollBar Global System Resources & Overrides                             -->
    <!-- Тонкие сдержанные скроллбары (8-10px, трек #10131B, бегунок #30364A,      -->
    <!-- hover #806BFF)                                                            -->
    <!-- ========================================================================= -->
    <x:Double x:Key="ScrollBarSize">10</x:Double>
    <x:Double x:Key="ScrollBarExpandedSize">10</x:Double>
    <CornerRadius x:Key="ScrollBarThumbCornerRadius">5,5,5,5</CornerRadius>
    <CornerRadius x:Key="ScrollBarCornerRadius">5,5,5,5</CornerRadius>

    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#10131B" />
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundPointerOver" Color="#10131B" />
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundPressed" Color="#10131B" />

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#30364A" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver" Color="#806BFF" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#9787FF" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundDisabled" Color="#171B25" />

    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#202532" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#806BFF" />
    <SolidColorBrush x:Key="ScrollBarButtonForeground" Color="#ADB5C6" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundPointerOver" Color="#F5F6FA" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarPanningMarkerBackground" Color="#806BFF" />

    <Style x:Key="SilkModernScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBackground}" />
        <Setter Property="Foreground" Value="{StaticResource ScrollBarThumbBackground}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource SilkModernScrollBarStyle}" />

    <!-- ========================================================================= -->
    <!-- WinUI Theme Overrides (Minimal Dark UI)                                   -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBase" Color="#0B0D12" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#10131B" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#171B25" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#202532" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#171B25" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#10131B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#171B25" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#202532" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#30364A" />
    <SolidColorBrush x:Key="CardStrokeColorDefault" Color="#30364A" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#30364A" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#30364A" />
    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="#0B0D12" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#10131B" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#10131B" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#171B25" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#30364A" />

    <!-- Button System Overrides -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#171B25" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#202532" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30364A" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#10131B" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#F5F6FA" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8892A6" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#30364A" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#514A70" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#806BFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#202532" />

    <!-- Form Controls System Overrides -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#202532" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#293141" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#202532" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#30364A" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#514A70" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#806BFF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#F5F6FA" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#ADB5C6" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#ADB5C6" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#ADB5C6" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#806BFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9787FF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6D55FA" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#30364A" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#202532" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#ADB5C6" />

    <!-- Progress Bar System Resources -->
    <CornerRadius x:Key="ProgressBarCornerRadius">2,2,2,2</CornerRadius>
    <CornerRadius x:Key="ProgressBarTrackCornerRadius">2,2,2,2</CornerRadius>
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#806BFF" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="#202532" />

    <!-- ========================================================================= -->
    <!-- ProgressBar Styles                                                        -->
    <!-- Тонкие аккуратные ProgressBar (Height="4", corner radius 2, #806BFF)      -->
    <!-- ========================================================================= -->
    <Style x:Key="SilkProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MaxHeight" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource SilkBrandBrush}" />
        <Setter Property="Background" Value="{StaticResource SilkSubsurfaceDarkBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource SilkProgressBarStyle}" />

    <!-- ========================================================================= -->
    <!-- Card & Surface Styles                                                     -->
    <!-- Скругление карточек: CornerRadius="12", Padding="20-24"                   -->
    <!-- ========================================================================= -->
    <Style x:Key="SilkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SilkTechCardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkTechCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="SilkInteractiveCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SilkCardDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkStrokeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SilkBentoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SilkTechCardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkTechCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Subsurface Tile Style (CornerRadius="8" or "10", Background="#202532") -->
    <Style x:Key="SilkSubsurfaceTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SilkSubsurfaceDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkStrokeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SilkBentoTileStyle" TargetType="Border" BasedOn="{StaticResource SilkSubsurfaceTileStyle}" />

    <!-- ========================================================================= -->
    <!-- Typography Styles                                                         -->
    <!-- ========================================================================= -->
    <Style x:Key="SilkPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SilkTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SilkPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SilkTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="SilkSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SilkTextSecondaryBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Button Styles                                                             -->
    <!-- Высота: 38px, CornerRadius: 8                                             -->
    <!-- ========================================================================= -->

    <!-- SilkPrimaryButtonStyle: фон #806BFF, hover #9787FF, pressed #6D55FA, CR 8, H 38 -->
    <Style x:Key="SilkPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SilkTechBrandGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkBrandHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- SilkSecondaryButtonStyle: фон #171B25, border #30364A, hover #202532, CR 8, H 38 -->
    <Style x:Key="SilkSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SilkCardDarkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SilkTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkStrokeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- SilkSubsurfaceButtonStyle: фон #202532, border #30364A, hover #30364A, CR 8, H 38 -->
    <Style x:Key="SilkSubsurfaceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SilkSubsurfaceDarkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SilkTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkStrokeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- SilkDangerButtonStyle: фон #1AEF4444, border #EF4444, CR 8, H 38 -->
    <Style x:Key="SilkDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SilkErrorBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SilkErrorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SilkErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <!-- A destructive action keeps its semantic color in every state. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="DangerPresenter"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <ContentPresenter.BackgroundTransition><BrushTransition Duration="0:0:0.10" /></ContentPresenter.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="DangerPresenter.Background" Value="#26EF4444" />
                                        <Setter Target="DangerPresenter.BorderBrush" Value="#F87171" />
                                        <Setter Target="DangerPresenter.Foreground" Value="#FCA5A5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="DangerPresenter.Background" Value="#3DEF4444" />
                                        <Setter Target="DangerPresenter.BorderBrush" Value="#EF4444" />
                                        <Setter Target="DangerPresenter.Foreground" Value="#FCA5A5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="DangerPresenter.Background" Value="{StaticResource ButtonBackgroundDisabled}" />
                                        <Setter Target="DangerPresenter.BorderBrush" Value="{StaticResource ButtonBorderBrushDisabled}" />
                                        <Setter Target="DangerPresenter.Foreground" Value="{StaticResource ButtonForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SilkDialogPrimaryButtonStyle -->
