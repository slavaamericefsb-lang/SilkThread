<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SilkThread.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:SilkThread.App.Helpers"
    Title="SilkThread — Windows Gaming Optimizer"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot" Background="{StaticResource SilkBackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar (Height 48, Minimal Dark UI) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="{StaticResource SilkTechHeaderGradient}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleBarDragRegion" Grid.ColumnSpan="2" Background="Transparent" />

            <!-- Top Left Logo Container (Lightning Bolt in Purple Rounded Container) -->
            <Grid Grid.Column="0" Width="72" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SilkTechBrandGradient}" BorderBrush="#BC9CFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- App Title & Brand Info -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SilkThread" FontWeight="SemiBold" FontSize="15" CharacterSpacing="70" Foreground="{StaticResource SilkTextPrimaryBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource SilkBrandSelectionBrush}" BorderBrush="#665A8C" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="BrandSubtitleText" Text="WINDOWS GAMING OPTIMIZER" FontSize="10" CharacterSpacing="60" FontWeight="SemiBold" Foreground="#C4B5FD" />
                </Border>
            </StackPanel>

            <!-- Quick Controls: Admin Badge and Language Switcher -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,160,0" VerticalAlignment="Center">
                <!-- Admin Shield Badge (Minimal Dark UI: #181B25, border #2B3040) -->
                <Button x:Name="AdminModeButton" Click="AdminModeButton_Click" Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Padding="12,4" Height="30" MinHeight="30" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="AdminStatusDot" Width="6" Height="6" CornerRadius="3" Background="{StaticResource SilkSuccessBrush}" VerticalAlignment="Center"
                                helpers:PulseAnimation.IsEnabled="False" />
                        <FontIcon x:Name="AdminStatusIcon" Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource SilkSuccessBrush}" />
                        <TextBlock x:Name="AdminStatusText" Text="Admin ✓" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SilkSuccessBrush}" />
                    </StackPanel>
                </Button>

                <!-- Language Switcher Pill (Minimal Dark UI: #181B25, border #2B3040) -->
                <Border Background="{StaticResource SilkCardDarkBrush}" BorderBrush="{StaticResource SilkStrokeDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnLangRu" Click="BtnLangRu_Click" Height="26" MinHeight="26" Padding="10,3" CornerRadius="6" Background="{StaticResource SilkBrandBrush}" BorderThickness="0">
                            <TextBlock Text="RU" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Button>
                        <Button x:Name="BtnLangEn" Click="BtnLangEn_Click" Height="26" MinHeight="26" Padding="10,3" CornerRadius="6" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="EN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SilkTextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="#53406C" />
        </Grid>

        <InfoBar x:Name="ElevationFeedback" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" Margin="88,8,24,0" />

        <!-- Navigation View: Minimal Dark 64px Rail -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            Background="{StaticResource SilkBackgroundDarkBrush}"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="72"
            OpenPaneLength="72"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.Resources>
                <!-- Minimal Dark Navigation Tokens -->
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SilkTechRailGradient" />
                <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SilkTechRailGradient" />
                <StaticResource x:Key="NavigationViewContentGridBackground" ResourceKey="SilkBackgroundDarkBrush" />
                <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SilkBackgroundDarkBrush" />

                <!-- Selection & Hover Brushes -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#C4B5FD" />
                <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6343DB" Offset="0"/><GradientStop Color="#392C67" Offset="1"/></LinearGradientBrush>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#6F50E7" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#5135AD" />
                <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#F3F4F8" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F3F4F8" />
                <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />

                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#282138" />
                <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#332848" />
                <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#A6A2BC" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#A6A2BC" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavDashboard" Content="Главная" Tag="Dashboard" ToolTipService.ToolTip="Главная" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavTweaks" Content="Библиотека твиков" Tag="Tweaks" ToolTipService.ToolTip="Библиотека твиков" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavScanner" Content="Диагностика ПК" Tag="Scanner" ToolTipService.ToolTip="Диагностика ПК" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavOptimization" Content="Мастер оптимизации" Tag="Optimization" ToolTipService.ToolTip="Мастер оптимизации" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavGames" Content="Игровые параметры" Tag="Games" ToolTipService.ToolTip="Игровые параметры" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavSystemSettings" Content="Системные настройки" Tag="SystemSettings" ToolTipService.ToolTip="Системные настройки" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavHistory" Content="История и откат" Tag="History" ToolTipService.ToolTip="История и откат" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavRestore" Content="Точки восстановления" Tag="Restore" ToolTipService.ToolTip="Точки восстановления" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Margin="8,3" MinHeight="44" CornerRadius="10" x:Name="NavSettings" Content="Параметры" Tag="Settings" ToolTipService.ToolTip="Параметры" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main Content Area with Fluid Fade Navigation Animation -->
            <Frame x:Name="ContentFrame" Margin="0" Background="{StaticResource SilkBackgroundDarkBrush}">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SuppressNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
