<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SilkThread.Core.Models"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Background="#0E1017" Padding="28,20,28,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Refresh Button -->
                <Button Command="{x:Bind ViewModel.LoadHistoryCommand}"
                        Style="{StaticResource SilkSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#806BFF" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshBtnLabel, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Button>

                <!-- Clear History Button -->
                <Button Click="ClearHistoryButton_Click"
                        Style="{StaticResource SilkSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                        <TextBlock Text="{x:Bind ViewModel.ClearBtnLabel, Mode=OneWay}" FontSize="12" Foreground="#F3F4F8" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status Notification -->
        <InfoBar Grid.Row="1" Severity="Informational"
                 IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- History ListView Container with Header Bar -->
        <Border x:Name="HistoryCard" Grid.Row="2" Style="{StaticResource SilkCardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Header Bar (Minimal Dark UI #202431 with #2B3040 border) -->
                <Border Grid.Row="0" Background="#202431" 
                        BorderBrush="#2B3040" BorderThickness="1" 
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.ColTime, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#969CAB" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontSize="10" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.ColTweak, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#969CAB" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" FontSize="10" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.ColCategory, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#969CAB" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7C3;" FontSize="10" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.ColStatus, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#969CAB" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ColAction, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#969CAB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- History Records List -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.HistoryRecords}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="20" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TweakAuditRecord">
                            <Border Background="#181B25" 
                                    BorderBrush="#2B3040" 
                                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Date & Time -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind FormattedDate}" FontSize="12" Foreground="#F3F4F8" FontFamily="Consolas" />
                                        <TextBlock Text="{x:Bind FormattedTime}" FontSize="10.5" Foreground="#969CAB" FontFamily="Consolas" />
                                    </StackPanel>

                                    <!-- Tweak Title & ID -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind TweakName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TweakId}" FontSize="10" Foreground="#969CAB" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Category Chip -->
                                    <Border Grid.Column="2" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Category, Converter={StaticResource CategoryToIconConverter}}" 
                                                      FontSize="11" Foreground="#806BFF" />
                                            <TextBlock Text="{x:Bind Category, Converter={StaticResource LocalizedCategoryConverter}}" 
                                                       FontSize="11" Foreground="#969CAB" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Status Badge (Applied, RolledBack, Failed) -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Background="{x:Bind Status, Converter={StaticResource StatusToBackgroundConverter}}" 
                                            BorderBrush="{x:Bind Status, Converter={StaticResource StatusToBorderConverter}}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Status, Converter={StaticResource StatusToIconConverter}}" 
                                                      FontSize="10" Foreground="{x:Bind Status, Converter={StaticResource StatusToColorConverter}}" />
                                            <TextBlock Text="{x:Bind Status, Converter={StaticResource LocalizedStatusConverter}}" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{x:Bind Status, Converter={StaticResource StatusToColorConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Rollback Action Button -->
                                    <Button Grid.Column="4" HorizontalAlignment="Right"
                                            Click="RollbackButton_Click"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind IsRolledBack, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource SilkSecondaryButtonStyle}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="#806BFF" />
                                            <TextBlock Text="{x:Bind TweakId, Converter={StaticResource ActionTextConverter}, ConverterParameter=Hist_Rollback_Btn}" FontSize="11" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"
                            Visibility="{x:Bind ViewModel.HasNoRecords, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.EmptyTitleLabel, Mode=OneWay}" 
                                   FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F8" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" 
                                   FontSize="12" Foreground="#969CAB" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" LineHeight="17" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
