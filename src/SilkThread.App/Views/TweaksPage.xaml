<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SilkThread.App.ViewModels"
    xmlns:helpers="using:SilkThread.App.Helpers"
    Loaded="Page_Loaded"
    Background="#0E1017"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- High-Contrast Minimal Dark ScrollBar Geometry & Sizing -->
                    <x:Double x:Key="ScrollBarSize">14</x:Double>
                    <x:Double x:Key="ScrollBarExpandedSize">16</x:Double>
                    <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
                    <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
                    <x:Double x:Key="ScrollBarThumbOffset">0</x:Double>
                    <x:Double x:Key="ScrollBarThumbStrokeThickness">0</x:Double>
                    <x:String x:Key="ScrollBarExpandBeginTime">00:00:00</x:String>
                    <x:String x:Key="ScrollBarExpandDuration">00:00:00.08</x:String>
                    <CornerRadius x:Key="ScrollBarCornerRadius">4</CornerRadius>

                    <!-- Minimal Dark UI ScrollBar Colors: Dark Track, Slate Thumb, Electric Accent Glow Hover -->
                    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#3A4156" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver" Color="#806BFF" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#9D8CFF" />

                    <!-- Native ScrollBar Theme Mappings -->
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarBackground" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#121520" />
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A4156" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#806BFF" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#9D8CFF" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#3A4156" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Direct StaticResource Keys -->
            <x:Double x:Key="ScrollBarSize">14</x:Double>
            <x:Double x:Key="ScrollBarExpandedSize">16</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
            <x:Double x:Key="ScrollBarThumbOffset">0</x:Double>
            <x:Double x:Key="ScrollBarThumbStrokeThickness">0</x:Double>
            <CornerRadius x:Key="ScrollBarCornerRadius">4</CornerRadius>

            <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#3A4156" />
            <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver" Color="#806BFF" />
            <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#9D8CFF" />

            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarBackground" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#121520" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A4156" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#806BFF" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#9D8CFF" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#3A4156" />

            <!-- Custom ScrollBar Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="MinWidth" Value="14" />
                <Setter Property="Background" Value="{ThemeResource ScrollBarTrackBackground}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,18,24,20" RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- 0: Header with stats and actions -->
            <RowDefinition Height="Auto" />
            <!-- 1: Notification InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Toolbar: Search on left, Category scroll in center -->
            <RowDefinition Height="Auto" />
            <!-- 3: Master/Detail Two-Panel Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0: Page Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page Title -->
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" 
                       FontSize="22" FontWeight="SemiBold" Foreground="#F3F4F8"
                       VerticalAlignment="Center" />

            <!-- Header Quick Stats & Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Summary Stats Pill -->
                <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.TotalPrefixLabel, Mode=OneWay}" FontSize="11" Foreground="#969CAB" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="#F3F4F8" />
                        </StackPanel>
                        <Border Width="1" Height="14" Background="#2B3040" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.AppliedPrefixLabel, Mode=OneWay}" FontSize="11" Foreground="#969CAB" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.AppliedCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="#22C55E" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Batch Apply Recommended -->
                <Button Command="{x:Bind ViewModel.ApplyRecommendedCommand}" 
                        Background="#806BFF" Foreground="White" BorderThickness="0"
                        CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" />
                        <TextBlock Text="{x:Bind ViewModel.BatchApplyRecLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Batch Revert Category -->
                <Button Command="{x:Bind ViewModel.RevertCategoryCommand}" 
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                        Foreground="#F3F4F8" CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="#EF4444" />
                        <TextBlock Text="{x:Bind ViewModel.BatchRevertLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1: Notification InfoBar -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.BatchStatusMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                 Message="{x:Bind ViewModel.BatchStatusMessage, Mode=OneWay}"
                 Severity="Informational" IsClosable="True" />

        <!-- 2: Toolbar: Search on Left, Category Ribbon in Center -->
        <Grid Grid.Row="2" ColumnSpacing="14" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Left side: Search input box (width ~240-280px) -->
                <ColumnDefinition Width="260" />
                <!-- Center: Horizontal category ribbon with mouse wheel support -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search Input Bar -->
            <Border Grid.Column="0"
                    Background="#202431"
                    BorderBrush="#2B3040"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0"
                    Height="38">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Magnifying Glass Icon -->
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="13" Foreground="#969CAB" VerticalAlignment="Center" />

                    <!-- Search Input -->
                    <TextBox x:Name="SearchInput" Grid.Column="1"
                             PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#F3F4F8"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Padding="0,8">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#F3F4F8" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F3F4F8" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F3F4F8" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#969CAB" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#969CAB" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#969CAB" />
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Clear Search button -->
                    <Button Grid.Column="2"
                            Click="ClearSearch_Click"
                            Visibility="{x:Bind ViewModel.SearchQuery, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                            Background="Transparent" BorderThickness="0" Padding="4"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#969CAB" />
                    </Button>
                </Grid>
            </Border>

            <!-- Center: Horizontal Category Ribbon with Smooth Scroll & Mouse Wheel Support -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Scroll Left Arrow Button -->
                <Button x:Name="ScrollCategoriesLeftButton" Grid.Column="0"
                        Click="ScrollCategoriesLeft_Click"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                        Padding="7,7" Margin="0,0,6,0"
                        CornerRadius="8"
                        AutomationProperties.Name="Scroll categories left"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ScrollLeftTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="#806BFF" />
                </Button>

                <!-- Category Pills ScrollViewer with mouse wheel & swipe support -->
                <ScrollViewer x:Name="CategoriesScrollViewer" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              helpers:SmoothScroll.IsEnabled="True">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryTabItem">
                                <Button Click="CategoryButton_Click"
                                        Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind Icon}" FontSize="12" Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                        <!-- Badge with count -->
                                        <Border Background="{x:Bind BadgeBackgroundBrush, Mode=OneWay}" 
                                                CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{x:Bind BadgeForegroundBrush, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Scroll Right Arrow Button -->
                <Button x:Name="ScrollCategoriesRightButton" Grid.Column="2"
                        Click="ScrollCategoriesRight_Click"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                        Padding="7,7" Margin="6,0,0,0"
                        CornerRadius="8"
                        AutomationProperties.Name="Scroll categories right"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ScrollRightTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#806BFF" />
                </Button>
            </Grid>
        </Grid>

        <!-- 3: Master/Detail Two-Panel Workspace -->
        <Grid Grid.Row="3" ColumnSpacing="16" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Browser List (width ~550–580px) -->
                <ColumnDefinition Width="570" />
                <!-- Right Panel: Inspector Details (width *) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================================= -->
            <!-- LEFT PANEL: Compact Tweaks Browser                                        -->
            <!-- ========================================================================= -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" 
                    Background="#181B25" 
                    BorderBrush="#2B3040" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="14,14,8,14" 
                    VerticalAlignment="Stretch">
                <Grid RowSpacing="10" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <!-- 0: Quick Filters: «Все твики», «Применен», «Не применен» & Checkbox -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Count strip -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Compact Tweaks ListView -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Quick Filters (Все твики, Применен, Не применен) & Checkbox -->
                    <Grid Grid.Row="0" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Quick Filter Buttons: «Все твики», «Применен», «Не применен» -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <!-- Все твики -->
                            <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="All"
                                    Background="{x:Bind ViewModel.FilterAllBg, Mode=OneWay}"
                                    BorderBrush="{x:Bind ViewModel.FilterAllBorder, Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}" 
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.FilterAllFg, Mode=OneWay}" />
                            </Button>

                            <!-- Применен -->
                            <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="Applied"
                                    Background="{x:Bind ViewModel.FilterAppliedBg, Mode=OneWay}"
                                    BorderBrush="{x:Bind ViewModel.FilterAppliedBorder, Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.FilterAppliedLabel, Mode=OneWay}" 
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.FilterAppliedFg, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <!-- Не применен -->
                            <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="NotApplied"
                                    Background="{x:Bind ViewModel.FilterNotAppliedBg, Mode=OneWay}"
                                    BorderBrush="{x:Bind ViewModel.FilterNotAppliedBorder, Mode=OneWay}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="#969CAB" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.FilterNotAppliedLabel, Mode=OneWay}" 
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.FilterNotAppliedFg, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ToggleSwitch "Показать несовместимые" / "Скрыть несовместимые" -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.IncompatibleToggleLabel, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="#969CAB"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowIncompatible, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0"
                                          Margin="0"
                                          VerticalAlignment="Center">
                                <ToggleSwitch.Resources>
                                    <!-- Track On (#806BFF) -->
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#806BFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9482FF" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6E55F5" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#806BFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#9482FF" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6E55F5" />

                                    <!-- Track Off (#202431 / #2B3040) -->
                                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#202431" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#2B3040" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#181B25" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2B3040" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#3A4156" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#2B3040" />

                                    <!-- Knob Crisp White (#FFFFFF) -->
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFill" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillPressed" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Filtered Count Text Strip -->
                    <Grid Grid.Row="1" Margin="0,0,6,0">
                        <TextBlock Text="{x:Bind ViewModel.FilteredCountText, Mode=OneWay}" 
                                   FontSize="11" Foreground="#969CAB" />
                    </Grid>

                    <!-- Row 2: Compact Tweaks ListView -->
                    <ListView Grid.Row="2"
                              x:Name="TweaksListView"
                              ItemsSource="{x:Bind ViewModel.FilteredTweaks}"
                              SelectedItem="{x:Bind ViewModel.SelectedTweak, Mode=TwoWay}"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              helpers:SmoothScroll.IsEnabled="True"
                              VerticalAlignment="Stretch"
                              Padding="0,0,6,0">
                        <ListView.Resources>
                            <!-- Make native selection transparent so our custom border highlights shine -->
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TweakItemViewModel">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" 
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" 
                                        BorderThickness="1" CornerRadius="8" 
                                        Padding="0">
                                    <Grid>
                                        <!-- Thin Accent Strip on left for Selected Tweak (#806BFF) -->
                                        <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                CornerRadius="8,0,0,8"
                                                Background="#806BFF"
                                                Visibility="{x:Bind SelectedIndicatorVisibility, Mode=OneWay}" />

                                        <Grid Padding="12,10,12,10" Margin="3,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Title and Status badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Title (14px SemiBold #F3F4F8) -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Title, Mode=OneWay}" 
                                                           FontWeight="SemiBold" FontSize="14" Foreground="#F3F4F8" 
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <!-- Status Badge (with dot & label) -->
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                        Background="{x:Bind StatusBadgeBackground, Mode=OneWay}"
                                                        BorderBrush="{x:Bind StatusBadgeBorder, Mode=OneWay}"
                                                        BorderThickness="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="6" Height="6" Fill="{x:Bind StatusBadgeDot, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind LocalizedStatus, Mode=OneWay}" 
                                                                   FontSize="10" FontWeight="SemiBold" 
                                                                   Foreground="{x:Bind StatusBadgeForeground, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Row 1: Short Description (12px #969CAB, TextTrimming) -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind Description, Mode=OneWay}" 
                                                       FontSize="12" Foreground="#969CAB" 
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" 
                                                       Margin="0,4,0,0" LineHeight="16" />

                                            <!-- Row 2: Badges: Category, Risk, Recommendation -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                                <!-- Category Badge -->
                                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind Category, Converter={StaticResource CategoryToIconConverter}}" 
                                                                  FontSize="10" Foreground="#806BFF" />
                                                        <TextBlock Text="{x:Bind CategoryName, Mode=OneWay}" FontSize="10" Foreground="#969CAB" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Risk Badge (Low: #22C55E, Med: #F59E0B, High: #EF4444) -->
                                                <Border CornerRadius="4" Padding="6,2" 
                                                        Background="{x:Bind RiskBackground, Mode=OneWay}"
                                                        BorderBrush="{x:Bind RiskBorder, Mode=OneWay}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{x:Bind LocalizedRisk, Mode=OneWay}" 
                                                               FontSize="10" FontWeight="Bold" 
                                                               Foreground="{x:Bind RiskForeground, Mode=OneWay}" />
                                                </Border>

                                                <!-- Recommendation Badge -->
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{x:Bind RecommendationBackground, Mode=OneWay}"
                                                        BorderBrush="{x:Bind RecommendationBorder, Mode=OneWay}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{x:Bind LocalizedRecommendation, Mode=OneWay}" 
                                                               FontSize="10" FontWeight="Bold" 
                                                               Foreground="{x:Bind RecommendationForeground, Mode=OneWay}" />
                                                </Border>

                                                <!-- Reboot Tag if required -->
                                                <Border CornerRadius="4" Padding="5,2" Background="#26F59E0B"
                                                        BorderBrush="#F59E0B" BorderThickness="1"
                                                        Visibility="{x:Bind RequiresReboot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <FontIcon Glyph="&#xE777;" FontSize="8" Foreground="#F59E0B" />
                                                        <TextBlock Text="Reboot" FontSize="9" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- RIGHT PANEL: Selected Tweak Details Inspector                             -->
            <!-- ========================================================================= -->
            <Border x:Name="RightPanelBorder" Grid.Column="1" 
                    Background="#181B25" 
                    BorderBrush="#2B3040" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="20,20,10,20" 
                    VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Stretch">
                    <!-- Placeholder when no tweak is selected -->
                    <Border Visibility="{x:Bind ViewModel.HasSelectedTweak, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE71D;" FontSize="28" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.InspectorEmptyLabel, Mode=OneWay}" 
                                       FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F8" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.InspectorEmptySubLabel, Mode=OneWay}" 
                                       FontSize="12" Foreground="#969CAB" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                        </StackPanel>
                    </Border>

                    <!-- Inspector Content when tweak is selected -->
                    <Grid Visibility="{x:Bind ViewModel.HasSelectedTweak, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <!-- Details Scrollable Content -->
                            <RowDefinition Height="*" />
                            <!-- Bottom Action Bar -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Scrollable Inspector Content -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      helpers:SmoothScroll.IsEnabled="True"
                                      VerticalAlignment="Stretch"
                                      Padding="0,0,10,0">
                            <StackPanel Spacing="16">
                                <!-- HEADER OF SELECTED TWEAK -->
                                <StackPanel Spacing="10">
                                    <!-- Meta strip: Category, ID chip, Reboot tag -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Category Pill -->
                                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{x:Bind ViewModel.SelectedTweak.Category, Mode=OneWay, Converter={StaticResource CategoryToIconConverter}}" 
                                                              FontSize="13" Foreground="#806BFF" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTweak.CategoryName, Mode=OneWay, FallbackValue=''}" 
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#806BFF" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Monospace ID Chip -->
                                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Id, Mode=OneWay, FallbackValue=''}" 
                                                           FontSize="11" FontFamily="Consolas" Foreground="#969CAB" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Reboot Required Tag -->
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Background="#26F59E0B"
                                                BorderBrush="#F59E0B" BorderThickness="1"
                                                Visibility="{x:Bind ViewModel.SelectedTweak.RequiresReboot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="#F59E0B" />
                                                <TextBlock Text="{x:Bind ViewModel.RequiresRebootLabel, Mode=OneWay}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Tweak Title (20px SemiBold #F3F4F8) -->
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Title, Mode=OneWay, FallbackValue=''}" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#F3F4F8" TextWrapping="Wrap" />

                                    <!-- Badges Row: Risk, Recommendation, Status -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Risk Badge -->
                                        <Border CornerRadius="6" Padding="9,3"
                                                Background="{x:Bind ViewModel.SelectedTweak.RiskBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind ViewModel.SelectedTweak.RiskBorder, Mode=OneWay}"
                                                BorderThickness="1">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTweak.LocalizedRisk, Mode=OneWay, FallbackValue=''}" 
                                                       FontSize="11" FontWeight="Bold" 
                                                       Foreground="{x:Bind ViewModel.SelectedTweak.RiskForeground, Mode=OneWay}" />
                                        </Border>

                                        <!-- Recommendation Badge -->
                                        <Border CornerRadius="6" Padding="9,3"
                                                Background="{x:Bind ViewModel.SelectedTweak.RecommendationBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind ViewModel.SelectedTweak.RecommendationBorder, Mode=OneWay}"
                                                BorderThickness="1">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTweak.LocalizedRecommendation, Mode=OneWay, FallbackValue=''}" 
                                                       FontSize="11" FontWeight="Bold" 
                                                       Foreground="{x:Bind ViewModel.SelectedTweak.RecommendationForeground, Mode=OneWay}" />
                                        </Border>

                                        <!-- Status Badge with Smooth Pop Animation on Toggle -->
                                        <Border x:Name="InspectorStatusBadge" CornerRadius="6" Padding="9,3"
                                                Background="{x:Bind ViewModel.SelectedTweak.StatusBadgeBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind ViewModel.SelectedTweak.StatusBadgeBorder, Mode=OneWay}"
                                                BorderThickness="1"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="InspectorStatusBadgeScale" ScaleX="1.0" ScaleY="1.0" />
                                            </Border.RenderTransform>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="{x:Bind ViewModel.SelectedTweak.StatusBadgeDot, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTweak.LocalizedStatus, Mode=OneWay, FallbackValue=''}" 
                                                           FontSize="11" FontWeight="Bold" 
                                                           Foreground="{x:Bind ViewModel.SelectedTweak.StatusBadgeForeground, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- BLOCK 1: НАЗНАЧЕНИЕ И РЕШАЕМАЯ ПРОБЛЕМА -->
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#806BFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SectionProblemLabel, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Description, Mode=OneWay, FallbackValue=''}" 
                                                   FontSize="13" TextWrapping="Wrap" Foreground="#F3F4F8" LineHeight="20" />

                                        <!-- Problem Solved details -->
                                        <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="13" Foreground="#F59E0B" Margin="0,2,0,0" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTweak.ProblemSolved, Mode=OneWay, FallbackValue=''}" 
                                                           FontSize="12" TextWrapping="Wrap" Foreground="#969CAB" LineHeight="18" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- BLOCK 2: МЕХАНИЗМ РАБОТЫ (РЕЕСТР, КЛЮЧИ, ЗНАЧЕНИЯ) -->
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE90F;" FontSize="13" Foreground="#806BFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SectionMechanismLabel, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                        </StackPanel>

                                        <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTweak.HowItWorks, Mode=OneWay, FallbackValue=''}" 
                                                       FontSize="12" FontFamily="Consolas" Foreground="#C4B5FD" TextWrapping="Wrap" LineHeight="18" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- BLOCK 3: ОЖИДАЕМЫЙ ЭФФЕКТ -->
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#22C55E" />
                                            <TextBlock Text="{x:Bind ViewModel.SectionResultLabel, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                        </StackPanel>

                                        <Border Background="#181B25" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTweak.ExpectedResult, Mode=OneWay, FallbackValue=''}" 
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#22C55E" TextWrapping="Wrap" LineHeight="20" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- BLOCK 4: СОВМЕСТИМОСТЬ С ВАШЕЙ СИСТЕМОЙ -->
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE839;" FontSize="13" Foreground="#806BFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SectionCompatLabel, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                        </StackPanel>

                                        <!-- Compatible State (Green badge #22C55E) -->
                                        <Border Background="#1A22C55E" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="12,10"
                                                Visibility="{x:Bind ViewModel.SelectedTweak.IsCompatible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind ViewModel.FullCompatTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#22C55E" />
                                                    <TextBlock Text="{x:Bind ViewModel.FullCompatDesc, Mode=OneWay}" 
                                                               FontSize="11" Foreground="#F3F4F8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Incompatible State (Warning badge #F59E0B with reason) -->
                                        <Border Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10"
                                                Visibility="{x:Bind ViewModel.SelectedTweak.IsCompatible, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind ViewModel.IncompatibleWarningLabel, Mode=OneWay}" 
                                                               FontSize="13" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTweak.CompatibilityReason, Mode=OneWay, FallbackValue=''}" 
                                                               FontSize="12" Foreground="#F3F4F8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- DOCKED ACTION PANEL AT BOTTOM -->
                        <Border Grid.Row="1" BorderBrush="#2B3040" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                            <StackPanel Spacing="10">
                                <!-- Operation Execution Message Toast -->
                                <Border Background="#1A806BFF" BorderBrush="#806BFF" BorderThickness="1" CornerRadius="6" Padding="12,8"
                                        Visibility="{x:Bind ViewModel.SelectedTweak.LastOperationMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="13" Foreground="#806BFF" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTweak.LastOperationMessage, Mode=OneWay, FallbackValue=''}" 
                                                   FontSize="12" Foreground="#F3F4F8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Action Buttons & Execution Status -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Apply Button (Primary #806BFF) -->
                                    <Button Grid.Column="0" 
                                            Command="{x:Bind ViewModel.SelectedTweak.ApplyCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.SelectedTweak.CanApply, Mode=OneWay}"
                                            Background="#806BFF" Foreground="White" BorderThickness="0"
                                            CornerRadius="8" Padding="16,10"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Rollback Button (Secondary #202431 with #2B3040 border) -->
                                    <Button Grid.Column="1" 
                                            Command="{x:Bind ViewModel.SelectedTweak.RollbackCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.SelectedTweak.CanRollback, Mode=OneWay}"
                                            Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                                            Foreground="#F3F4F8" CornerRadius="8" Padding="16,10"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="13" Foreground="#EF4444" />
                                            <TextBlock Text="{x:Bind ViewModel.RevertLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Busy Progress Ring -->
                                    <ProgressRing Grid.Column="2"
                                                  IsActive="{x:Bind ViewModel.SelectedTweak.IsBusy, Mode=OneWay}"
                                                  Width="24" Height="24"
                                                  Foreground="#806BFF"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
