<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="SilkThread.App.Views.TweaksPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:SilkThread.App.Controls" xmlns:vm="using:SilkThread.App.ViewModels" xmlns:helpers="using:SilkThread.App.Helpers"
 Loaded="Page_Loaded" Background="{StaticResource SilkBackgroundDarkBrush}">
 <Grid Padding="24,20,24,24" RowSpacing="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource SilkTechHeroStyle}"><Grid x:Name="HeaderGrid" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <Border Grid.Column="1" Style="{StaticResource SilkSubsurfaceTileStyle}" Padding="12,8">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.TotalPrefixLabel, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.AppliedPrefixLabel, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.AppliedCount, Mode=OneWay}" Foreground="{StaticResource SilkSuccessBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
    </Grid>
   </Border>
  </Grid></Border>
  <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
  <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.BatchStatusMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}" Message="{x:Bind ViewModel.BatchStatusMessage, Mode=OneWay}" Severity="Informational" IsClosable="True"/>
  <StackPanel Grid.Row="2" Spacing="10">
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchInput" PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" MinWidth="0"/>
   <Button Grid.Column="1" Command="{x:Bind ViewModel.ApplyRecommendedCommand}" Style="{StaticResource SilkMinimalPrimaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8"><TextBlock Text="{x:Bind ViewModel.BatchApplyRecLabel, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
   <Button Grid.Column="2" Command="{x:Bind ViewModel.RevertCategoryCommand}" Style="{StaticResource SilkMinimalSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8"><TextBlock Text="{x:Bind ViewModel.BatchRevertLabel, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
  </Grid>
   <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
    <ComboBox MinWidth="170" ItemsSource="{x:Bind ViewModel.StatusFilters, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" AutomationProperties.Name="Status filter"/>
    <ComboBox MinWidth="150" ItemsSource="{x:Bind ViewModel.RiskFilters, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.RiskFilterIndex, Mode=TwoWay}" AutomationProperties.Name="Risk filter"/>
    <ComboBox MinWidth="210" ItemsSource="{x:Bind ViewModel.RebootFilters, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.RebootFilterIndex, Mode=TwoWay}" AutomationProperties.Name="Restart filter"/>
    <ToggleSwitch IsOn="{x:Bind ViewModel.HideIncompatible, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.CompatibilityFilterLabel, Mode=OneWay}"><ToggleSwitch.Header><TextBlock Text="{x:Bind ViewModel.CompatibilityFilterLabel, Mode=OneWay}" FontSize="12"/></ToggleSwitch.Header></ToggleSwitch>
   </controls:WrapPanel>
  </StackPanel>
  <!-- Three independently scrollable work areas; names and counts never depend on a ribbon offset. -->
  <Grid x:Name="WorkspaceGrid" Grid.Row="3" ColumnSpacing="14" RowSpacing="14" SizeChanged="WorkspaceGrid_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoriesColumn" Width="196"/><ColumnDefinition x:Name="BrowserColumn" Width="0.95*"/><ColumnDefinition x:Name="InspectorColumn" Width="1.15*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="InspectorRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="CategoriesPanel" Style="{StaticResource SilkTechCardStyle}" Padding="10,14,6,10" CornerRadius="14">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Bind ViewModel.InspectorCategoryLabel, Mode=OneWay}" Style="{StaticResource SilkSectionHeaderStyle}" Margin="8,0,6,0" TextWrapping="Wrap"/>
     <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="MinHeight" Value="46"/><Setter Property="CornerRadius" Value="8"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:CategoryTabItem">
       <Grid ColumnSpacing="8" Padding="8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind Icon}" FontSize="13" Foreground="{StaticResource SilkBrandBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="12" LineHeight="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Grid.Column="2" Background="{StaticResource SilkSidebarDarkBrush}" CornerRadius="5" Padding="5,3" VerticalAlignment="Center"><TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="11"/></Border>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Border x:Name="LeftPanelBorder" Grid.Column="1" Style="{StaticResource SilkMinimalCardStyle}" Padding="14,14,8,10" CornerRadius="14">
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Bind ViewModel.FilteredCountText, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
     <ListView helpers:ItemsEntrance.IsEnabled="True" x:Name="TweaksListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTweaks}" SelectedItem="{x:Bind ViewModel.SelectedTweak, Mode=TwoWay}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" helpers:SmoothScroll.IsEnabled="True" Padding="0,0,6,0">
      <ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/></ListView.Resources>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:TweakItemViewModel">
       <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel Spacing="7">
         <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SilkTextPrimaryBrush}"/>
         <!-- Preview alone is shortened; the inspector contains the full explanation. -->
         <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="18" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind LocalizedRisk, Mode=OneWay}" Foreground="{x:Bind RiskForeground, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{x:Bind LocalizedStatus, Mode=OneWay}" Foreground="{x:Bind StatusBadgeForeground, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" TextAlignment="Right"/>
         </Grid>
        </StackPanel>
       </Border>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Border x:Name="RightPanelBorder" Grid.Column="2" Style="{StaticResource SilkTechCardStyle}" Padding="18,18,10,14" CornerRadius="14">
    <Grid>
     <StackPanel Spacing="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8" Visibility="{x:Bind ViewModel.HasSelectedTweak, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
      <FontIcon Glyph="&#xE71D;" FontSize="28" Foreground="{StaticResource SilkBrandBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="{x:Bind ViewModel.InspectorEmptyLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
      <TextBlock Text="{x:Bind ViewModel.InspectorEmptySubLabel, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
     </StackPanel>
     <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.HasSelectedTweak, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" helpers:SmoothScroll.IsEnabled="True">
       <StackPanel Spacing="16">
        <StackPanel Spacing="8">
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.CategoryName, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SilkBrandBrush}"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Title, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="28"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Id, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}" IsTextSelectionEnabled="True"/>
         <Border x:Name="InspectorStatusBadge" Background="{x:Bind ViewModel.SelectedTweak.StatusBadgeBackground, Mode=OneWay}" BorderBrush="{x:Bind ViewModel.SelectedTweak.StatusBadgeBorder, Mode=OneWay}" BorderThickness="1" CornerRadius="7" Padding="10,7"><TextBlock Text="{x:Bind ViewModel.SelectedTweak.LocalizedStatus, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedTweak.StatusBadgeForeground, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/></Border>
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind ViewModel.SelectedTweak.LocalizedRisk, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedTweak.RiskForeground, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTweak.LocalizedRecommendation, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedTweak.RecommendationForeground, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
         </Grid>
         <TextBlock Text="{x:Bind ViewModel.RequiresRebootLabel, Mode=OneWay}" Foreground="{StaticResource SilkWarningBrush}" TextWrapping="Wrap" FontSize="12" Visibility="{x:Bind ViewModel.SelectedTweak.RequiresReboot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
        <Border Style="{StaticResource SilkSubsurfaceTileStyle}" Padding="14"><StackPanel Spacing="9"><TextBlock Text="{x:Bind ViewModel.SectionProblemLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.Description, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SilkTextPrimaryBrush}" IsTextSelectionEnabled="True"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.ProblemSolved, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SilkTextSecondaryBrush}" IsTextSelectionEnabled="True"/>
        </StackPanel></Border>
        <Border Style="{StaticResource SilkSubsurfaceTileStyle}" Padding="14"><StackPanel Spacing="9"><TextBlock Text="{x:Bind ViewModel.SectionMechanismLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.HowItWorks, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SilkTextPrimaryBrush}" IsTextSelectionEnabled="True"/>
        </StackPanel></Border>
        <Border Style="{StaticResource SilkSubsurfaceTileStyle}" Padding="14"><StackPanel Spacing="9"><TextBlock Text="{x:Bind ViewModel.SectionResultLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
         <TextBlock Text="{x:Bind ViewModel.SelectedTweak.ExpectedResult, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SilkSuccessBrush}" IsTextSelectionEnabled="True"/>
        </StackPanel></Border>
        <Border Style="{StaticResource SilkSubsurfaceTileStyle}" Padding="14"><StackPanel Spacing="9">
         <TextBlock Text="{x:Bind ViewModel.SectionCompatLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
         <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedTweak.IsCompatible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="{x:Bind ViewModel.FullCompatTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkSuccessBrush}"/><TextBlock Text="{x:Bind ViewModel.FullCompatDesc, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedTweak.IsCompatible, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><TextBlock Text="{x:Bind ViewModel.IncompatibleWarningLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkWarningBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedTweak.CompatibilityReason, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Spacing="10">
       <TextBlock Text="{x:Bind ViewModel.SelectedTweak.LastOperationMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Visibility="{x:Bind ViewModel.SelectedTweak.LastOperationMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Command="{x:Bind ViewModel.SelectedTweak.ApplyCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.SelectedTweak.CanApply, Mode=OneWay}" Style="{StaticResource SilkMinimalPrimaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,9"><TextBlock Text="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
        <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectedTweak.RollbackCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.SelectedTweak.CanRollback, Mode=OneWay}" Style="{StaticResource SilkMinimalSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,9"><TextBlock Text="{x:Bind ViewModel.RevertLabel, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
        <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.SelectedTweak.IsBusy, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Center"/>
       </Grid>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Page>
