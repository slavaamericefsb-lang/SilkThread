<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SilkThread.App.ViewModels"
    xmlns:models="using:SilkThread.Core.GameProfiles"
    xmlns:helpers="using:SilkThread.App.Helpers"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#0E1017" Padding="28,24,28,36"
                  helpers:SmoothScroll.IsEnabled="True">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- ========================================================================= -->
            <!-- 0: HEADER & STATS BADGES                                                 -->
            <!-- ========================================================================= -->
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Stats Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Total Profiles Badge -->
                    <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.StatTotalBadge, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F8" />
                        </StackPanel>
                    </Border>

                    <!-- Applied Profiles Badge -->
                    <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#806BFF" />
                            <TextBlock Text="{x:Bind ViewModel.AppliedProfilesSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#806BFF" />
                        </StackPanel>
                    </Border>

                    <!-- Esports Ready Badge -->
                    <Border Background="#22806BFF" BorderBrush="#806BFF" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="#806BFF" />
                            <TextBlock Text="{x:Bind ViewModel.StatReadyBadge, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#806BFF" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 1: FILTER BAR & SEARCH                                                    -->
            <!-- ========================================================================= -->
            <Grid x:Name="FilterGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category Segmented Filters -->
                <Border Grid.Column="0" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- All -->
                        <Button Click="BtnFilterAll_Click"
                                Padding="14,6" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsFilterAll, Mode=OneWay, Converter={StaticResource BoolToFilterBgConverter}}"
                                Foreground="{x:Bind ViewModel.IsFilterAll, Mode=OneWay, Converter={StaticResource BoolToFilterFgConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Button>

                        <!-- Shooters -->
                        <Button Click="BtnFilterShooters_Click"
                                Padding="14,6" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsFilterShooters, Mode=OneWay, Converter={StaticResource BoolToFilterBgConverter}}"
                                Foreground="{x:Bind ViewModel.IsFilterShooters, Mode=OneWay, Converter={StaticResource BoolToFilterFgConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.FilterShootersLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Button>

                        <!-- MOBA -->
                        <Button Click="BtnFilterMoba_Click"
                                Padding="14,6" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsFilterMoba, Mode=OneWay, Converter={StaticResource BoolToFilterBgConverter}}"
                                Foreground="{x:Bind ViewModel.IsFilterMoba, Mode=OneWay, Converter={StaticResource BoolToFilterFgConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.FilterMobaLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Button>

                        <!-- Battle Royale -->
                        <Button Click="BtnFilterBattleRoyale_Click"
                                Padding="14,6" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsFilterBattleRoyale, Mode=OneWay, Converter={StaticResource BoolToFilterBgConverter}}"
                                Foreground="{x:Bind ViewModel.IsFilterBattleRoyale, Mode=OneWay, Converter={StaticResource BoolToFilterFgConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.FilterBattleRoyaleLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Search Input -->
                <TextBox Grid.Column="1"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                         Width="340" Height="36" CornerRadius="8"
                         Background="#202431" BorderBrush="#2B3040"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2: GRID OF GAME CARDS (Bento Cards)                                       -->
            <!-- ========================================================================= -->
            <ItemsControl x:Name="GameCardsControl" ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 4 columns grid on 1080p/1440p displays -->
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <Button Click="GameCard_Click"
                                Width="280" Margin="0,0,14,14" Padding="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="12">
                            <Grid>
                                <!-- Outer Glowing Border on Selected Game Card -->
                                <Border CornerRadius="14" Margin="-1.5"
                                        BorderBrush="#806BFF" BorderThickness="2"
                                        Opacity="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToGlowOpacityConverter}}"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToElevationConverter}}" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border CornerRadius="12"
                                        Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToCardBgConverter}}"
                                        BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToCardBorderConverter}}"
                                        BorderThickness="1.5"
                                        Padding="16,14">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToElevationConverter}}" />
                                    </Border.RenderTransform>
                                    <StackPanel Spacing="10">
                                    <!-- Badges Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Engine & Launcher Badges -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <!-- Engine Badge -->
                                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{x:Bind EngineBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#969CAB" />
                                            </Border>
                                            <!-- Launcher Badge -->
                                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{x:Bind Launcher}" FontSize="10" FontWeight="SemiBold" Foreground="#969CAB" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1"
                                                Background="{x:Bind IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToStatusBgConverter}}"
                                                BorderBrush="{x:Bind IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToStatusBorderConverter}}"
                                                BorderThickness="1" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{x:Bind IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToStatusFgConverter}}" />
                                        </Border>
                                    </Grid>

                                    <!-- Game Title & Genre -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Genre}" FontSize="11" Foreground="#969CAB" />
                                    </StackPanel>

                                    <!-- Bottom Info: Color Line Indicator & Action Hint -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="11" Foreground="#806BFF" />
                                            <TextBlock Text="Esports Profile" FontSize="10" FontWeight="SemiBold" Foreground="#806BFF" />
                                        </StackPanel>

                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Foreground="#969CAB" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty Search State -->
            <Border Visibility="{x:Bind ViewModel.FilteredGames.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                    Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="12" Padding="32" Margin="0,8,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="#969CAB" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.NoResultsText, Mode=OneWay}" FontSize="13" Foreground="#969CAB" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- 3: INTERACTIVE DETAIL DRAWER / EXPANDING VIEW (Bento Container)           -->
            <!-- ========================================================================= -->
            <Border x:Name="DetailCard"
                    Visibility="{x:Bind ViewModel.SelectedGame, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}"
                    Style="{StaticResource SilkCardStyle}"
                    BorderBrush="#3B4259"
                    Padding="24">
                <StackPanel Spacing="24">

                    <!-- Drawer Top: Selected Game Brand Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Game Title and Description -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedGame.Title, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#F3F4F8" />
                                <Border Background="#22806BFF" BorderBrush="#806BFF" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.EngineBadge, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#806BFF" />
                                </Border>
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.Launcher, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SelectedGame.Description, Mode=OneWay}" FontSize="12" Foreground="#969CAB" />
                        </StackPanel>

                        <!-- Action: Quick Apply or Status Pill -->
                        <Border Grid.Column="1"
                                Background="#181B25" BorderBrush="#2B3040" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"
                                          Foreground="{x:Bind ViewModel.SelectedGame.IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToStatusFgConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.SystemProfileStatusText, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.SelectedGame.IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToStatusFgConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ================================================================= -->
                    <!-- БЛОК 1: «ПАРАМЕТРЫ ЗАПУСКА» (Launch Options)                      -->
                    <!-- ================================================================= -->
                    <Border Background="#131620" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="14">
                            <!-- Block Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#806BFF" />
                                        <TextBlock Text="{x:Bind ViewModel.Block1Title, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F3F4F8" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Block1Subtitle, Mode=OneWay}" FontSize="11" Foreground="#969CAB" />
                                </StackPanel>

                                <!-- Copy Button with Spring Bounce Feedback Animation -->
                                <Button x:Name="CopyLaunchOptionsButton"
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.CopyLaunchOptionsCommand}"
                                        Click="CopyLaunchOptionsButton_Click"
                                        Style="{StaticResource SilkPrimaryButtonStyle}"
                                        Height="36" Padding="16,6">
                                    <StackPanel x:Name="CopyButtonContent" Orientation="Horizontal" Spacing="8" RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <ScaleTransform x:Name="CopyButtonScale" ScaleX="1.0" ScaleY="1.0" />
                                        </StackPanel.RenderTransform>
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="{x:Bind ViewModel.IsCopied, Mode=OneWay, Converter={StaticResource BoolToCopyBtnTextConverter}}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Monospace Launch String Display Box -->
                            <Border Background="#0E1017" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <TextBlock Text="{x:Bind ViewModel.SelectedGame.LaunchOptions, Mode=OneWay}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Consolas, Cascadia Code, Courier New"
                                           FontSize="12"
                                           Foreground="#9787FF"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Breakdown of Each Argument -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.BreakdownTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGame.LaunchArgs, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LaunchArgItem">
                                            <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Argument Flag -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind Argument}"
                                                               FontFamily="Consolas, Cascadia Code"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="#806BFF"
                                                               VerticalAlignment="Center" />

                                                    <!-- Purpose & Impact -->
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Purpose}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                                        <TextBlock Text="{x:Bind Impact}" FontSize="11" Foreground="#969CAB" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- БЛОК 2: «РЕКОМЕНДОВАННЫЕ НАСТРОЙКИ ГРАФИКИ» (Video Settings)      -->
                    <!-- ================================================================= -->
                    <Border Background="#131620" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="14">
                            <!-- Block Header -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="#806BFF" />
                                    <TextBlock Text="{x:Bind ViewModel.Block2Title, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F3F4F8" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Block2Subtitle, Mode=OneWay}" FontSize="11" Foreground="#969CAB" />
                            </StackPanel>

                            <!-- Video Settings Grid -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGame.VideoSettings, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VideoSettingItem">
                                        <Border Width="520" Margin="0,0,10,8"
                                                Background="#181B25" BorderBrush="#2B3040" BorderThickness="1"
                                                CornerRadius="8" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Setting Name & Impact -->
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                                    <TextBlock Text="{x:Bind EsportsImpact}" FontSize="11" Foreground="#969CAB" />
                                                </StackPanel>

                                                <!-- Recommended Value Pill -->
                                                <Border Grid.Column="1"
                                                        Background="#202431" BorderBrush="#806BFF" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind RecommendedValue}" FontSize="11" FontWeight="Bold" Foreground="#806BFF" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- БЛОК 3: «ОПТИМИЗАЦИЯ КОНФИГОВ И WINDOWS» (OS & Config Tuning)     -->
                    <!-- ================================================================= -->
                    <Border Background="#131620" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="16">
                            <!-- Block Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#806BFF" />
                                        <TextBlock Text="{x:Bind ViewModel.Block3Title, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F3F4F8" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Block3Subtitle, Mode=OneWay}" FontSize="11" Foreground="#969CAB" />
                                </StackPanel>

                                <!-- Apply System Profile Action Button -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <!-- Revert Button (visible if applied) -->
                                    <Button Visibility="{x:Bind ViewModel.SelectedGame.IsProfileApplied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{x:Bind ViewModel.RevertSystemProfileCommand}"
                                            Style="{StaticResource SilkSecondaryButtonStyle}"
                                            Height="38" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="12" Foreground="#EF4444" />
                                            <TextBlock Text="{x:Bind ViewModel.RevertProfileBtnText, Mode=OneWay}" FontSize="12" Foreground="#EF4444" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Apply Button -->
                                    <Button Command="{x:Bind ViewModel.ApplySystemProfileCommand}"
                                            Style="{StaticResource SilkPrimaryButtonStyle}"
                                            Height="38" Padding="18,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#FFFFFF" />
                                            <TextBlock Text="{x:Bind ViewModel.ApplyProfileBtnText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Windows OS Tuning Pillars -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pillar 1: High GPU Preference -->
                                <Border Grid.Column="0" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="#806BFF" />
                                            <TextBlock Text="High GPU Preference" FontSize="12" FontWeight="Bold" Foreground="#F3F4F8" />
                                        </StackPanel>
                                        <TextBlock Text="Назначает дискретную видеокарту в реестре DirectX UserGpuPreferences (GpuPreference=2)" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Pillar 2: DirectFlip & Disable FSO -->
                                <Border Grid.Column="1" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="#806BFF" />
                                            <TextBlock Text="DirectFlip &amp; Disable FSO" FontSize="12" FontWeight="Bold" Foreground="#F3F4F8" />
                                        </StackPanel>
                                        <TextBlock Text="Отключает оконный оверлей DWM и активирует режим прямого аппаратного сканирования кадров" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Pillar 3: IFEO High Process Priority -->
                                <Border Grid.Column="2" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="#806BFF" />
                                            <TextBlock Text="IFEO High CPU Priority" FontSize="12" FontWeight="Bold" Foreground="#F3F4F8" />
                                        </StackPanel>
                                        <TextBlock Text="Задает приоритет реального времени (CpuPriorityClass=3, IoPriority=3) через PerfOptions" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Config Files List -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="РАСПОЛОЖЕНИЕ КОНФИГУРАЦИОННЫХ ФАЙЛОВ И АВТОЭКЗЕКОВ" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGame.ConfigFiles, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ConfigFileInfo">
                                            <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind FileName}" FontSize="12" FontWeight="Bold" Foreground="#806BFF" />
                                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="#969CAB" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Path}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="#969CAB" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Copy Path Button -->
                                                    <Button Grid.Column="1"
                                                            Click="CopyConfigPath_Click"
                                                            Tag="{x:Bind Path}"
                                                            Style="{StaticResource SilkSecondaryButtonStyle}"
                                                            Height="32" Padding="12,4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#806BFF" />
                                                            <TextBlock Text="Копировать путь" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
