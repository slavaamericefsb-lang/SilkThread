<Page x:Class="SilkThread.App.Views.SystemSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:SilkThread.App.ViewModels" xmlns:helpers="using:SilkThread.App.Helpers"
 Loaded="Page_Loaded" Background="{StaticResource SilkBackgroundDarkBrush}">
 <Grid Padding="24,20,24,28" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource SilkTechHeroStyle}"><Grid x:Name="HeaderPanel" ColumnSpacing="20" RowSpacing="12" helpers:ResponsiveColumns.Breakpoint="880">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderActionsColumn" Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4">
    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}"/>
    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Click="RefreshAll_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource SilkBrandBrush}"/><TextBlock Text="{x:Bind ViewModel.PowerRefresh, Mode=OneWay}"/></StackPanel>
    </Button>
    <Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Click="CopyReport_Click">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{StaticResource SilkBrandBrush}"/><TextBlock Text="{x:Bind ViewModel.ExportLabel, Mode=OneWay}"/></StackPanel>
    </Button>
   </StackPanel>
  </Grid></Border>
  <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasOperationStatus, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.OperationStatus, Mode=OneWay}"/>
  <Grid Grid.Row="2" x:Name="Workspace" SizeChanged="Workspace_SizeChanged" ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="280"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Pivot x:Name="SettingsTabs" SelectedIndex="{x:Bind ViewModel.ActiveTab, Mode=TwoWay}">
    <Pivot.Resources><SolidColorBrush x:Key="PivotHeaderItemSelectedPipeFill" Color="#806BFF"/><SolidColorBrush x:Key="PivotHeaderItemFocusPipeFill" Color="#806BFF"/><Style TargetType="PivotHeaderItem"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,4,0"/></Style></Pivot.Resources>
    <PivotItem Margin="0" Header="{x:Bind ViewModel.PowerTabTitle, Mode=OneWay}"><Border Style="{StaticResource SilkMinimalCardStyle}" Padding="18" Margin="0,10,0,0"><ScrollViewer helpers:SmoothScroll.IsEnabled="True" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Padding="4,16,12,20">
     <TextBlock Text="{x:Bind ViewModel.ActivePowerSchemeName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.ActivePowerSchemeId, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
     <TextBlock Text="{x:Bind ViewModel.PowerCheckedAt, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
     <TextBlock Text="{x:Bind ViewModel.SupplyReport, Mode=OneWay}" TextWrapping="Wrap"/>
     <ComboBox ItemsSource="{x:Bind ViewModel.PowerSchemes}" SelectedItem="{x:Bind ViewModel.SelectedPowerScheme, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsPowerBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" Header="{x:Bind ViewModel.PowerTitle, Mode=OneWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"/>
     <TextBlock Text="{x:Bind ViewModel.PowerNotice, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
     <Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Content="{x:Bind ViewModel.PowerRestore, Mode=OneWay}" Click="RestorePower_Click"/>
     <TextBlock Text="{x:Bind ViewModel.PowerStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#F59E0B"/>
    </StackPanel></ScrollViewer></Border></PivotItem>
    <PivotItem Margin="0" Header="{x:Bind ViewModel.MemoryTabTitle, Mode=OneWay}"><Border Style="{StaticResource SilkMinimalCardStyle}" Padding="18" Margin="0,10,0,0"><ScrollViewer helpers:SmoothScroll.IsEnabled="True" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Padding="4,16,12,20">
     <TextBlock Text="{x:Bind ViewModel.PageRiskLabel, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
     <ToggleSwitch Header="{x:Bind ViewModel.AutomaticLabel, Mode=OneWay}" OnContent="{x:Bind ViewModel.EnabledLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.DisabledLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.AutomaticPageFile, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditMemory, Mode=OneWay}"/>
     <ItemsControl ItemsSource="{x:Bind ViewModel.PageFileEditors}" IsEnabled="{x:Bind ViewModel.CanEditManual, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PageFileVolumeEditor">
      <Border Background="{StaticResource SilkSubsurfaceDarkBrush}" BorderBrush="{StaticResource SilkStrokeDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel Spacing="8">
       <TextBlock Text="{x:Bind Path}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <ComboBox ItemsSource="{x:Bind Modes, Mode=OneWay}" SelectedIndex="{x:Bind Mode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBox Header="{x:Bind InitialLabel, Mode=OneWay}" Text="{x:Bind Initial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" IsEnabled="{x:Bind IsCustom, Mode=OneWay}"/>
        <TextBox Grid.Column="1" Header="{x:Bind MaximumLabel, Mode=OneWay}" Text="{x:Bind Maximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" IsEnabled="{x:Bind IsCustom, Mode=OneWay}"/>
       </Grid>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <CheckBox IsChecked="{x:Bind ViewModel.AllowRemoval, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditManual, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.RemovalLabel, Mode=OneWay}" TextWrapping="Wrap"/></CheckBox>
     <Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Content="{x:Bind ViewModel.PageRestoreLabel, Mode=OneWay}" Click="RestoreMemory_Click"/>
     <TextBlock Text="{x:Bind ViewModel.PageFileStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#F59E0B"/>
     <TextBlock Text="{x:Bind ViewModel.MemoryReport, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel></ScrollViewer></Border></PivotItem>
    <PivotItem Margin="0" Header="{x:Bind ViewModel.CpuTitle, Mode=OneWay}"><Border Style="{StaticResource SilkMinimalCardStyle}" Padding="18" Margin="0,10,0,0"><ScrollViewer helpers:SmoothScroll.IsEnabled="True" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{x:Bind ViewModel.CpuReport, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,12,8,20"/></ScrollViewer></Border></PivotItem>
    <PivotItem Margin="0" Header="{x:Bind ViewModel.DevicesTitle, Mode=OneWay}"><Border Style="{StaticResource SilkMinimalCardStyle}" Padding="18" Margin="0,10,0,0"><ScrollViewer helpers:SmoothScroll.IsEnabled="True" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Padding="4,16,12,20"><Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Content="{x:Bind ViewModel.GraphicsSettingsLabel, Mode=OneWay}" Click="GraphicsSettings_Click"/><Button Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Content="{x:Bind ViewModel.HagsTweakLabel, Mode=OneWay}" Click="HagsTweak_Click"/><TextBlock Text="{x:Bind ViewModel.DeviceReport, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></ScrollViewer></Border></PivotItem>
    <PivotItem Margin="0" Header="{x:Bind ViewModel.TimersTitle, Mode=OneWay}"><Border Style="{StaticResource SilkMinimalCardStyle}" Padding="18" Margin="0,10,0,0"><ScrollViewer helpers:SmoothScroll.IsEnabled="True" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{x:Bind ViewModel.BcdReport, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,12,8,20"/></ScrollViewer></Border></PivotItem>
   </Pivot>
   <Border x:Name="InspectorPanel" Grid.Column="1" Style="{StaticResource SilkMinimalCardStyle}" Padding="20" Margin="0,48,0,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" helpers:SmoothScroll.IsEnabled="True">
     <StackPanel Spacing="16">
      <TextBlock Text="{x:Bind ViewModel.InspectorTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource SilkTextPrimaryBrush}"/>
      <Border Style="{StaticResource SilkSubsurfaceTileStyle}"><TextBlock Text="{x:Bind ViewModel.AccessReport, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/></Border>
      <TextBlock Text="{x:Bind ViewModel.InspectorText, Mode=OneWay}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource SilkTextSecondaryBrush}" IsTextSelectionEnabled="True"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource SilkMinimalCardStyle}" BorderBrush="{StaticResource SilkBrandBrush}" Padding="16,12" Visibility="{x:Bind ViewModel.HasPendingDrafts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.DraftTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{x:Bind ViewModel.DraftSummary, Mode=OneWay}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button Content="{x:Bind ViewModel.DiscardLabel, Mode=OneWay}" Style="{StaticResource SilkMinimalSecondaryButtonStyle}" Click="Discard_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
     <Button Content="{x:Bind ViewModel.ReviewLabel, Mode=OneWay}" Style="{StaticResource SilkMinimalPrimaryButtonStyle}" Click="ReviewSelection_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Page>
