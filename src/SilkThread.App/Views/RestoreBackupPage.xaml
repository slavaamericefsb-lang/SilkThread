<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.RestoreBackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SilkThread.Core.Models"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer Background="#0E1017" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Page Title & Subtitle -->
            <StackPanel x:Name="HeaderPanel" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Status Notification InfoBar -->
            <InfoBar Severity="Informational"
                     IsOpen="{x:Bind ViewModel.OperationMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}" />

            <!-- CARD 1: WINDOWS SYSTEM PROTECTION STATUS -->
            <Border x:Name="CardProtection" Style="{StaticResource SilkCardStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ProtectionCardTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                <TextBlock Text="{x:Bind ViewModel.SubProtectionLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Protection Status Badge -->
                        <Border Grid.Column="1" Background="#1E22C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#22C55E" />
                                <TextBlock Text="{x:Bind ViewModel.ProtectionStatusBadge, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#22C55E" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Protection Detail Subsurface Tile -->
                    <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SubStatusLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                <TextBlock Text="{x:Bind ViewModel.StatusDescription, Mode=OneWay}" FontSize="12.5" Foreground="#F3F4F8" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.RefreshStatusCommand}"
                                        Style="{StaticResource SilkSecondaryButtonStyle}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#806BFF" />
                                        <TextBlock Text="{x:Bind ViewModel.CheckBtnLabel, Mode=OneWay}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind ViewModel.OpenWindowsRestoreUiCommand}"
                                        Style="{StaticResource SilkSecondaryButtonStyle}" Padding="12,6"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RstruiTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE78B;" FontSize="11" Foreground="#38BDF8" />
                                        <TextBlock Text="rstrui.exe" FontSize="11.5" FontFamily="Consolas" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD 2: CREATE RESTORE POINT -->
            <Border x:Name="CardCreate" Style="{StaticResource SilkCardStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CreateCardTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                            <TextBlock Text="{x:Bind ViewModel.SubSnapshotLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.CreateCardDesc, Mode=OneWay}" 
                               FontSize="12.5" Foreground="#969CAB" LineHeight="17" />

                    <!-- Input Bar -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{x:Bind ViewModel.NewRestorePointName, Mode=TwoWay}"
                                 PlaceholderText="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                                 Background="#202431" BorderBrush="#2B3040" Foreground="#F3F4F8"
                                 CornerRadius="8" Padding="14,10" VerticalAlignment="Center" />

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SilkPrimaryButtonStyle}" Padding="20,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.CreateBtnLabel, Mode=OneWay}" FontWeight="Bold" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 3: SNAPSHOT TIMELINE & LIST OF RESTORE POINTS -->
            <Border x:Name="CardTimeline" Style="{StaticResource SilkCardStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                <TextBlock Text="{x:Bind ViewModel.SubTimelineLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.RestorePointsCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#806BFF" />
                                    <TextBlock Text="{x:Bind ViewModel.SubPointsCountLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" />
                                </StackPanel>
                            </Border>

                            <Button Command="{x:Bind ViewModel.LoadRestorePointsCommand}"
                                    Style="{StaticResource SilkSecondaryButtonStyle}" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#806BFF" />
                                    <TextBlock Text="{x:Bind ViewModel.RefreshListLabel, Mode=OneWay}" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Busy ProgressBar -->
                    <ProgressBar IsIndeterminate="True" 
                                 Height="4" CornerRadius="2"
                                 Foreground="#806BFF" Background="#202431"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Restore Points List -->
                    <ListView ItemsSource="{x:Bind ViewModel.RestorePoints}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RestorePointItem">
                                <Border Background="#202431" 
                                        BorderBrush="#2B3040" 
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Sequence Number Badge -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" 
                                                Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SequenceNumber}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Description & Meta -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Description}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind FormattedCreationTime}" FontSize="11" Foreground="#969CAB" FontFamily="Consolas" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                    <TextBlock Text="{x:Bind EventTypeString}" FontSize="9.5" FontWeight="SemiBold" Foreground="#969CAB" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons: Rollback & Delete -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Rollback button -->
                                            <Button Click="RollbackPointButton_Click"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource SilkSecondaryButtonStyle}" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="#806BFF" />
                                                    <TextBlock Text="{x:Bind Description, Converter={StaticResource ActionTextConverter}, ConverterParameter=Rest_Rollback_Btn}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete button -->
                                            <Button Click="DeletePointButton_Click"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource SilkSecondaryButtonStyle}" Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                                                    <TextBlock Text="{x:Bind Description, Converter={StaticResource ActionTextConverter}, ConverterParameter=Rest_Delete_Btn}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="28"
                            Visibility="{x:Bind ViewModel.HasNoPoints, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE90F;" FontSize="28" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.EmptyTitleLabel, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F8" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" 
                                           FontSize="12" Foreground="#969CAB" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" LineHeight="17" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
