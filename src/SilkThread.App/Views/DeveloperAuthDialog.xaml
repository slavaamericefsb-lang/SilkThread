<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SilkThread.App.Views.DeveloperAuthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="14"
    BorderBrush="#2B3040"
    BorderThickness="1"
    Background="#181B25"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">540</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">460</x:Double>
    </ContentDialog.Resources>

    <Grid Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="18" Margin="0">
        <Grid.RowDefinitions>
            <!-- 0: Header with icon and titles -->
            <RowDefinition Height="Auto" />
            <!-- 1: Key Input Box -->
            <RowDefinition Height="Auto" />
            <!-- 2: Error Status -->
            <RowDefinition Height="Auto" />
            <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon Container -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" 
                    Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEBE8;" FontSize="20" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleTextBlock" Text="Режим разработчика" FontSize="18" FontWeight="SemiBold" Foreground="#F3F4F8" />
                <TextBlock x:Name="SubtitleTextBlock" Text="Введите ключ разработчика для доступа к панели отладки" FontSize="12.5" Foreground="#969CAB" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 1: Key Input -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Ключ разработчика" FontSize="11.5" FontWeight="SemiBold" Foreground="#969CAB" />
            <PasswordBox x:Name="KeyPasswordBox" 
                         PlaceholderText="Введите ключ доступа..."
                         PasswordRevealMode="Peek"
                         Background="#202431" 
                         BorderBrush="#2B3040" 
                         Foreground="#F3F4F8" 
                         CornerRadius="8" 
                         Padding="12,8" 
                         Height="38"
                         Loaded="KeyPasswordBox_Loaded"
                         KeyDown="KeyPasswordBox_KeyDown"
                         PasswordChanged="KeyPasswordBox_PasswordChanged" />
        </StackPanel>

        <!-- 2: Error Status -->
        <TextBlock x:Name="ErrorTextBlock" 
                   Grid.Row="2" 
                   Text="Неверный ключ доступа" 
                   FontSize="12" 
                   Foreground="#EF4444" 
                   Visibility="Collapsed" 
                   Margin="2,0,0,0" />

        <!-- 3: Action Buttons -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <!-- Cancel -->
                <Button x:Name="BtnCancel" Click="BtnCancel_Click"
                        Style="{StaticResource SilkSubsurfaceButtonStyle}"
                        Width="Auto" MinWidth="90" Height="38" Padding="16,8" CornerRadius="8"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                    <TextBlock Text="Отмена" FontSize="13" Foreground="#F3F4F8" TextWrapping="NoWrap" />
                </Button>

                <!-- Enter / Submit -->
                <Button x:Name="BtnSubmit" Click="BtnSubmit_Click"
                        Style="{StaticResource SilkPrimaryButtonStyle}"
                        Width="Auto" MinWidth="110" Height="38" Padding="16,8" CornerRadius="8"
                        Background="#806BFF" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="#FFFFFF" />
                        <TextBlock Text="Войти" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
