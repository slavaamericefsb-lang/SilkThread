<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:SilkThread.Core.Models" x:Class="SilkThread.App.Views.PcScannerPage" Loaded="Page_Loaded" Background="{StaticResource SilkBackgroundDarkBrush}" SizeChanged="Page_SizeChanged">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="28,24,28,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="20" Padding="22" BorderThickness="1" BorderBrush="#685194" Background="{StaticResource SilkTechHeroGradient}">
            <StackPanel x:Name="HeaderGrid" Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="26" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="ScanButton_Click" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource SilkPrimaryButtonStyle}">
                        <TextBlock Text="{x:Bind ViewModel.ScanBtnText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Click="CopyReportButton_Click" Style="{StaticResource SilkSecondaryButtonStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CopyBtnText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Value="0"/>
        <InfoBar Grid.Row="2" Severity="Success" IsOpen="{x:Bind ViewModel.HasCopyMessage, Mode=OneWay}" Message="{x:Bind ViewModel.CopyReportSuccessMessage, Mode=OneWay}"/>

            <Grid Grid.Row="3" x:Name="HardwareGrid" HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="CardCpu" Style="{StaticResource SilkCardStyle}" Padding="20" Grid.Row="0" Grid.Column="0" CornerRadius="16" BorderBrush="#3A3850" Background="#1B1E2B" VerticalAlignment="Stretch">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2C2543">
                                <FontIcon Glyph="" FontSize="16" Foreground="#B28AFF"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CardCpuTitle, Mode=OneWay}" FontSize="17" Foreground="#B28AFF" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="13">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblCpuModel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" FontSize="17" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblTopology, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuCoresThreads, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblMaxClock, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuMaxClock, Mode=OneWay}" FontSize="26" Foreground="#B28AFF" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblCpuCache, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuCache, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblVbsSecurity, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuVbs, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CardRam" Style="{StaticResource SilkCardStyle}" Padding="20" Grid.Row="0" Grid.Column="1" CornerRadius="16" BorderBrush="#3A3850" Background="#1B1E2B" VerticalAlignment="Stretch">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2C2543">
                                <FontIcon Glyph="" FontSize="16" Foreground="#D09CFF"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CardRamTitle, Mode=OneWay}" FontSize="17" Foreground="#D09CFF" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="13">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblRamTotal, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.RamTotalGb, Mode=OneWay}" FontSize="26" Foreground="#D09CFF" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblRamAvail, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.RamAvailGb, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblRamSpeed, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.RamSpeed, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblRamConfig, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.RamTypeModules, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblChannelMode, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.RamChannelMode, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Height="4" Value="{x:Bind ViewModel.RamUsedPercentage, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CardGpu" Style="{StaticResource SilkCardStyle}" Padding="20" Grid.Row="1" Grid.Column="0" CornerRadius="16" BorderBrush="#3A3850" Background="#1B1E2B" VerticalAlignment="Stretch">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2C2543">
                                <FontIcon Glyph="" FontSize="16" Foreground="#64D3DF"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CardGpuTitle, Mode=OneWay}" FontSize="17" Foreground="#64D3DF" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:GpuInfo">
                                    <Border BorderBrush="{StaticResource SilkStrokeDarkBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            <TextBlock Text="{x:Bind FormattedDriverVersion}" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="VRAM" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind FormattedVram}" FontSize="22" TextWrapping="Wrap" Foreground="#BCA2FF"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="DirectX" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind DirectXVersion}" FontSize="14" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="5">
                                                    <TextBlock Text="HAGS" Foreground="{StaticResource SilkTextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind HagsStatusString}" FontSize="14" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="CardOs" Style="{StaticResource SilkCardStyle}" Padding="20" Grid.Row="1" Grid.Column="1" CornerRadius="16" BorderBrush="#3A3850" Background="#1B1E2B" VerticalAlignment="Stretch">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2C2543">
                                <FontIcon Glyph="" FontSize="16" Foreground="#8EAAFF"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CardOsTitle, Mode=OneWay}" FontSize="17" Foreground="#8EAAFF" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="13">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblOsEditionHeader, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.OsEdition, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblOsBuild, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.OsBuild, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblPowerPlan, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.OsPowerPlan, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblDeviceForm, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IsLaptopText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblPowerState, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.IsAcText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblGameMode, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.OsGameMode, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.LblCoreIsolation, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.OsCoreIsolation, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" Grid.Column="1" IsTextSelectionEnabled="True"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CardStorage" Style="{StaticResource SilkCardStyle}" Padding="20" Grid.Row="2" Grid.Column="0" CornerRadius="16" BorderBrush="#3A3850" Background="#1B1E2B" VerticalAlignment="Stretch" Grid.ColumnSpan="2">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2C2543">
                                <FontIcon Glyph="" FontSize="16" Foreground="#B29DFF"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CardStorageTitle, Mode=OneWay}" FontSize="17" Foreground="#B29DFF" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LblStorageSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StorageDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskDriveInfo">
                                    <Border Background="{StaticResource SilkSubsurfaceDarkBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DriveLetter}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SilkBrandBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Model}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                    <TextBlock Text="{x:Bind DriveFormat}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{x:Bind UsedPercentage}"/>
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="22" TextWrapping="Wrap" Foreground="#BCA2FF"/>
                                                    <TextBlock Text="{x:Bind FormattedUsedSpace}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedFreeSpace}" FontSize="14" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="TRIM" FontSize="13"/>
                                                    <FontIcon Glyph="" FontSize="12" Foreground="{StaticResource SilkSuccessBrush}" Visibility="{x:Bind SupportsTrim, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <FontIcon Glyph="" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" Visibility="{x:Bind SupportsTrim, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

    </Grid>
    </ScrollViewer>
</Page>
