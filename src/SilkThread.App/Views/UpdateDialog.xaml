<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SilkThread.App.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Padding="24"
    CornerRadius="14"
    BorderBrush="#2B3040"
    BorderThickness="1"
    Background="#181B25"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
    </ContentDialog.Resources>

    <Grid Width="512" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- 0: Header with Brand Icon, Titles, and Version Badge -->
            <RowDefinition Height="Auto" />
            <!-- 1: Release Details Banner Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Changelog / Description Box -->
            <RowDefinition Height="Auto" />
            <!-- 3: Download Progress (Visible during download) -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Buttons Row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header with Brand Icon, Title/Subtitle, and Cleanly Right-Aligned Version Badge -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Icon + Title + Subtitle -->
            <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand Icon -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" 
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="DialogTitleText" Text="Вышло новое обновление!" FontSize="18" FontWeight="SemiBold" Foreground="#F3F4F8" />
                    <TextBlock x:Name="CurrentVersionHintText" Text="Рекомендуется обновить SilkThread для стабильной работы" FontSize="13" Foreground="#969CAB" />
                </StackPanel>
            </Grid>

            <!-- Column 1: Version Badge cleanly right-aligned with safety margin -->
            <Border Grid.Column="1" Background="#1E1736" BorderBrush="#806BFF" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#806BFF" />
                    <TextBlock x:Name="BadgeVersionText" Text="v1.2.0" FontSize="11.5" FontWeight="Bold" Foreground="#806BFF" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 1: Release Details Banner Card (Title, Date & Official Badge) -->
        <Border Grid.Row="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="ReleaseTitleText" Text="SilkThread Update" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ReleaseDateText" Text="Дата релиза: 2026-11-09" FontSize="12" Foreground="#969CAB" />
                </StackPanel>

                <Border Grid.Column="1" Background="#162E22" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0">
                    <TextBlock x:Name="OfficialBadgeText" Text="Официальный релиз" FontSize="11" FontWeight="Bold" Foreground="#22C55E" />
                </Border>
            </Grid>
        </Border>

        <!-- 2: Changelog / Description Box -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="WhatsNewHeaderText" Text="Что нового в этой версии:" FontSize="13" FontWeight="SemiBold" Foreground="#969CAB" />
            <Border Background="#121520" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DescriptionText" 
                               Text="• Полная переработка интерфейса в стиле Minimal Dark Bento Grid&#x0a;• Устранение дрожания плиток в игровой матрице задержек&#x0a;• Дистанционная доставка обновлений SilkThread Auto-Update" 
                               FontSize="13" LineHeight="20" Foreground="#F3F4F8" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- 3: Download Progress (Visible during download) -->
        <StackPanel x:Name="DownloadProgressPanel" Grid.Row="3" Spacing="8" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="DownloadStatusText" Text="Загрузка обновления..." FontSize="12.5" Foreground="#969CAB" HorizontalAlignment="Left" />
                <TextBlock x:Name="DownloadPercentText" Text="0%" FontSize="12.5" FontWeight="Bold" Foreground="#806BFF" HorizontalAlignment="Right" Margin="0,0,2,0" />
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" MaxHeight="4" CornerRadius="2" Foreground="#806BFF" Background="#202431" />
        </StackPanel>

        <!-- 4: Action Buttons Row -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status / Error message on the left -->
            <TextBlock x:Name="ErrorMessageText" Grid.Column="0" Text="" FontSize="12" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,0,12,0" />

            <!-- Action Buttons on the right -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <!-- Secondary: «Позже» -->
                <Button x:Name="BtnLater" Click="BtnLater_Click"
                        Style="{StaticResource SilkSubsurfaceButtonStyle}"
                        Width="Auto" MinWidth="90" Height="38" MinHeight="38" Padding="16,8" CornerRadius="8"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                    <TextBlock x:Name="BtnLaterText" Text="Позже" FontSize="13" Foreground="#F3F4F8" />
                </Button>

                <!-- Primary: «Обновить» -->
                <Button x:Name="BtnUpdate" Click="BtnUpdate_Click"
                        Style="{StaticResource SilkPrimaryButtonStyle}"
                        Width="Auto" MinWidth="170" Height="38" MinHeight="38" Padding="16,8" CornerRadius="8"
                        Background="#806BFF" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="#FFFFFF" />
                        <TextBlock x:Name="BtnUpdateText" Text="Обновить" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="None" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
