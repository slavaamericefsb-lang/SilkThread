<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SilkThread.App.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="14"
    BorderBrush="#2B3040"
    BorderThickness="1"
    Background="#181B25"
    RequestedTheme="Dark">

    <Grid Width="520" RowSpacing="16" Margin="4">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Release Details Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Changelog / Description -->
            <RowDefinition Height="Auto" />
            <!-- 3: Download Progress (Visible during download) -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header with Brand Icon and Version Badge -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" 
                    Background="#202431" BorderBrush="#2B3040" BorderThickness="1"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Вышло новое обновление!" FontSize="17" FontWeight="Bold" Foreground="#F3F4F8" />
                <TextBlock x:Name="CurrentVersionHintText" Text="Рекомендуется обновить SilkThread для стабильной работы" FontSize="11.5" Foreground="#969CAB" />
            </StackPanel>

            <!-- Version Badge on the right -->
            <Border Grid.Column="2" Background="#1E1736" BorderBrush="#806BFF" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#806BFF" />
                    <TextBlock x:Name="BadgeVersionText" Text="v1.2.0" FontSize="11" FontWeight="Bold" Foreground="#806BFF" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 1: Release Details Card (Title & Date) -->
        <Border Grid.Row="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ReleaseTitleText" Text="Minimal Dark UI &amp; IOST Update" FontSize="13.5" FontWeight="SemiBold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ReleaseDateText" Text="Дата релиза: 2026-11-09" FontSize="11" Foreground="#969CAB" />
                </StackPanel>

                <Border Grid.Column="1" Background="#162E22" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="Официальный релиз" FontSize="10" FontWeight="Bold" Foreground="#22C55E" />
                </Border>
            </Grid>
        </Border>

        <!-- 2: Changelog / Description -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Что нового в этой версии:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
            <Border Background="#11141D" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DescriptionText" 
                               Text="• Полная переработка интерфейса в стиле Minimal Dark Bento Grid&#x0a;• Устранение дрожания плиток в игровой матрице задержек&#x0a;• Дистанционная доставка обновлений SilkThread Auto-Update" 
                               FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="17" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- 3: Download Progress (Visible during download) -->
        <StackPanel x:Name="DownloadProgressPanel" Grid.Row="3" Spacing="8" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="DownloadStatusText" Text="Загрузка обновления..." FontSize="11.5" Foreground="#CBD5E1" HorizontalAlignment="Left" />
                <TextBlock x:Name="DownloadPercentText" Text="0%" FontSize="11.5" FontWeight="Bold" Foreground="#806BFF" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" CornerRadius="2.5" Foreground="#806BFF" Background="#202431" />
        </StackPanel>

        <!-- 4: Action Buttons -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status / Error message on the left -->
            <TextBlock x:Name="ErrorMessageText" Grid.Column="0" Text="" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="14" />

            <!-- Secondary: «Позже» -->
            <Button x:Name="BtnLater" Grid.Column="1" Click="BtnLater_Click"
                    Style="{StaticResource SilkSecondaryButtonStyle}" 
                    Margin="0,0,10,0" Padding="18,8">
                <TextBlock Text="Позже" FontSize="12.5" Foreground="#F3F4F8" />
            </Button>

            <!-- Primary: «Обновить» -->
            <Button x:Name="BtnUpdate" Grid.Column="2" Click="BtnUpdate_Click"
                    Style="{StaticResource SilkPrimaryButtonStyle}" Padding="22,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="White" />
                    <TextBlock Text="Обновить" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
