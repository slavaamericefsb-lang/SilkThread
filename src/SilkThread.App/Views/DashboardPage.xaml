<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SilkThread.App.ViewModels" xmlns:controls="using:SilkThread.App.Controls" xmlns:helpers="using:SilkThread.App.Helpers" x:Class="SilkThread.App.Views.DashboardPage" Loaded="Page_Loaded" Background="{StaticResource SilkBackgroundDarkBrush}" SizeChanged="Page_SizeChanged">
    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,24,28,36">
        <StackPanel HorizontalAlignment="Stretch" Spacing="24">
            <StackPanel x:Name="HeaderGrid" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" FontSize="28" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.IsOptimizing, Mode=OneWay}" Severity="Informational" Title="{x:Bind ViewModel.OptimizingTitle, Mode=OneWay}" Message="{x:Bind ViewModel.OptimizationStatus, Mode=OneWay}"/>
            <Border x:Name="SummaryCard" Style="{StaticResource SilkCardStyle}" Padding="28" BorderBrush="#685194" CornerRadius="20" MinHeight="284" Background="{StaticResource SilkTechHeroGradient}">
                <StackPanel Spacing="22">
                    <TextBlock Text="{x:Bind ViewModel.StatScoreLabel, Mode=OneWay}" FontSize="12" Foreground="#CDBEFF" TextWrapping="Wrap" FontWeight="SemiBold" CharacterSpacing="100"/>
                    <Grid ColumnSpacing="30" RowSpacing="20" helpers:ResponsiveColumns.Breakpoint="740">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="164"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="156" Height="156" VerticalAlignment="Center">
                            <Ellipse Stroke="#504366" StrokeThickness="7"/>
                            <Ellipse Stroke="#B28AFF" StrokeThickness="7" StrokeDashArray="34,3" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SystemScore, Mode=OneWay}" FontSize="58" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.IndexLabel, Mode=OneWay}" FontSize="11" Foreground="#D0C7E2" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.ScoreHeroTitle, Mode=OneWay}" FontSize="25" Foreground="#FFFFFF" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.ScoreDescription, Mode=OneWay}" FontSize="14" Foreground="#D1CADF" TextWrapping="Wrap"/>
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                <Button Command="{x:Bind ViewModel.AutoOptimizeSafeCommand}" Style="{StaticResource SilkPrimaryButtonStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.QuickOptimizeBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.OpenTweaksCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.AllTweaksBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                                </Button>
                            </controls:WrapPanel>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.RunningProcessesCount, Mode=OneWay}" FontSize="22" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.StatProcessesLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.RecommendedTweaksCount, Mode=OneWay}" FontSize="22" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.StatSafeRecsLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.TotalTweaksCount, Mode=OneWay}" FontSize="22" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.StatCatalogLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="HardwareCard" Style="{StaticResource SilkCardStyle}" Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.HwTitle, Mode=OneWay}" FontSize="18" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <Grid x:Name="HardwareTiles" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HardwareTile0" Grid.Row="0" Grid.Column="0" Background="#1C202D" BorderBrush="#34364B" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#29233F" Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top">
                                    <FontIcon Glyph="" FontSize="18" Foreground="#A996FF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.HwCpuLabel, Mode=OneWay}" FontSize="11" Foreground="#A996FF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#F5F2FF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.CpuCoresThreads, Mode=OneWay}" FontSize="12" Foreground="#AAA9BE" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="HardwareTile1" Grid.Row="0" Grid.Column="1" Background="#1C202D" BorderBrush="#34364B" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#29233F" Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top">
                                    <FontIcon Glyph="" FontSize="18" Foreground="#68D6DF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.HwGpuLabel, Mode=OneWay}" FontSize="11" Foreground="#68D6DF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#F5F2FF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.GpuVram, Mode=OneWay}" FontSize="12" Foreground="#AAA9BE" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="HardwareTile2" Grid.Row="1" Grid.Column="0" Background="#1C202D" BorderBrush="#34364B" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#29233F" Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top">
                                    <FontIcon Glyph="" FontSize="18" Foreground="#CB9CFF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.HwRamLabel, Mode=OneWay}" FontSize="11" Foreground="#CB9CFF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamTotalGb, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#F5F2FF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamDetails, Mode=OneWay}" FontSize="12" Foreground="#AAA9BE" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="HardwareTile3" Grid.Row="1" Grid.Column="1" Background="#1C202D" BorderBrush="#34364B" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#29233F" Width="40" Height="40" CornerRadius="12" VerticalAlignment="Top">
                                    <FontIcon Glyph="" FontSize="18" Foreground="#8FAEFF"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.HwStorageLabel, Mode=OneWay}" FontSize="11" Foreground="#8FAEFF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.StorageName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#F5F2FF" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.StorageDetails, Mode=OneWay}" FontSize="12" Foreground="#AAA9BE" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#191D29" BorderBrush="#34364B" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.OsName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OsDetails, Mode=OneWay}" FontSize="12" Foreground="#AAA9BE" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Button Command="{x:Bind ViewModel.OpenScannerCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                        <TextBlock Text="{x:Bind ViewModel.HwDiagBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Button>
                </StackPanel>
            </Border>
            <Grid x:Name="LogicGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="AiCard" Style="{StaticResource SilkCardStyle}" Padding="22" CornerRadius="16" BorderBrush="#403852" Background="#1B1C2A" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{x:Bind ViewModel.AiBentoTitle, Mode=OneWay}" FontSize="18" Foreground="#B28AFF" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.AiBentoSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.IsIostActive, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" Severity="Informational" Message="{x:Bind ViewModel.IostInactiveNotice, Mode=OneWay}"/>
                        <Button Command="{x:Bind ViewModel.OpenSettingsCommand}" Style="{StaticResource SilkSecondaryButtonStyle}" MaxWidth="420">
                            <TextBlock Text="{x:Bind ViewModel.OpenSettingsBtnText, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"/>
                        </Button>
                        <ContentControl IsEnabled="{x:Bind ViewModel.IsIostActive, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.AiScenarioHeader, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiScenarios}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiSurveyOptionItem">
                                                <Button Click="AiScenario_Click" Background="{x:Bind BackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="14,9" MaxWidth="420">
                                                    <TextBlock Text="{x:Bind FormattedTitle, Mode=OneWay}" FontSize="13" Foreground="{x:Bind TextBrush, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.AiPriorityHeader, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiPriorities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiSurveyOptionItem">
                                                <Button Click="AiPriority_Click" Background="{x:Bind BackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="14,9" MaxWidth="420">
                                                    <TextBlock Text="{x:Bind FormattedTitle, Mode=OneWay}" FontSize="13" Foreground="{x:Bind TextBrush, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.AiRiskHeader, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiRisks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiSurveyOptionItem">
                                                <Button Click="AiRisk_Click" Background="{x:Bind BackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="8" Padding="14,9" MaxWidth="420">
                                                    <TextBlock Text="{x:Bind FormattedTitle, Mode=OneWay}" FontSize="13" Foreground="{x:Bind TextBrush, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.AiAnalysisSectionTitle, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.AiAnalysisIndicatorText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsAiAnalyzing, Mode=OneWay}" Height="4" Value="0"/>
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.ForecastFpsLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.ForecastFpsValue, Mode=OneWay}" FontSize="16" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.ForecastLatencyLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.ForecastLatencyValue, Mode=OneWay}" FontSize="16" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.ForecastRamLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind ViewModel.ForecastRamValue, Mode=OneWay}" FontSize="16" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.AiProgressStatus, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Button Command="{x:Bind ViewModel.GenerateAiPresetCommand}" Style="{StaticResource SilkPrimaryButtonStyle}" MaxWidth="420">
                                    <TextBlock Text="{x:Bind ViewModel.AiGenerateBtnText, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"/>
                                </Button>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </Border>
                <Border x:Name="LatencyCard" Style="{StaticResource SilkCardStyle}" Padding="22" Grid.Column="1" CornerRadius="16" BorderBrush="#403852" Background="#1B1C2A" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{x:Bind ViewModel.LatencyTitle, Mode=OneWay}" FontSize="18" Foreground="#8FAEFF" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.LatencySubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsMatrixActive, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="{x:Bind ViewModel.LatencyTitle, Mode=OneWay}"/>
                        <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.LatencyInputTitle, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.LatencyInputDesc, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleLatencyTileCommand}" CommandParameter="raw_input" Style="{StaticResource SilkSecondaryButtonStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.RawInputStatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.LatencyHagsTitle, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.LatencyHagsDesc, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleLatencyTileCommand}" CommandParameter="hags" Style="{StaticResource SilkSecondaryButtonStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.HagsStatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.LatencyNetworkTitle, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.LatencyNetworkDesc, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleLatencyTileCommand}" CommandParameter="tcp_nodelay" Style="{StaticResource SilkSecondaryButtonStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.TcpStatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource SilkStrokeDarkBrush}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.LatencyMmcssTitle, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.LatencyMmcssDesc, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleLatencyTileCommand}" CommandParameter="mmcss" Style="{StaticResource SilkSecondaryButtonStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.MmcssStatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ActionsCard" Style="{StaticResource SilkCardStyle}" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{x:Bind ViewModel.PresetsTitle, Mode=OneWay}" FontSize="18" Foreground="{StaticResource SilkTextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.SecurityDesc, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SilkTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                        <Button Command="{x:Bind ViewModel.OpenRestoreCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.SecurityBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                        </Button>
                        <Button Command="{x:Bind ViewModel.CreatePresetCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.CreatePresetBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ActivatePresetCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.ActivatePresetBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                        </Button>
                        <Button Command="{x:Bind ViewModel.OpenOptimizationCommand}" Style="{StaticResource SilkSecondaryButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.PresetsWizardBtnText, Mode=OneWay}" TextWrapping="Wrap"/>
                        </Button>
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
