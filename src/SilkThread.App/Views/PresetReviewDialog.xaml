<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SilkThread.App.Views.PresetReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SilkThread.App.ViewModels"
    mc:Ignorable="d"
    CornerRadius="12"
    BorderBrush="#2B3040"
    BorderThickness="1"
    Background="#181B25"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">640</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="640" MaxWidth="780" HorizontalAlignment="Stretch" RowSpacing="14" Margin="2,4,2,2">
        <Grid.RowDefinitions>
            <!-- 0: Header & Preset Details (Card) -->
            <RowDefinition Height="Auto" />
            <!-- 1: Incompatibility Warning Banner (if applicable) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filter/Selection Quick Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Tweaks Scrollable List -->
            <RowDefinition Height="*" />
            <!-- 4: Progress Bar & Status (when applying) -->
            <RowDefinition Height="Auto" />
            <!-- 5: Action Buttons (Apply / Reject) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Preset Info Card (Minimal Dark UI #202431 with #2B3040 border) -->
        <Border Grid.Row="0" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title & Preset Total Badge -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="10">
                            <FontIcon Glyph="&#xE8F4;" FontSize="20" Foreground="#806BFF" />
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.PresetName, Mode=OneWay}" 
                                       FontSize="16" FontWeight="Bold" Foreground="#F3F4F8" />
                            <TextBlock Text="{x:Bind ViewModel.PresetDescription, Mode=OneWay}" 
                                       FontSize="12" Foreground="#969CAB" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Total count badge -->
                    <Border Grid.Column="1" Background="#181B25" 
                            BorderBrush="#2B3040" BorderThickness="1"
                            CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" FontSize="11" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#F3F4F8" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="#2B3040" Margin="0,1" />

                <!-- Metadata Row (Author, Date, Compatibility Badges) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Author and Date -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.PresetAuthor, Mode=OneWay}" FontSize="11.5" Foreground="#969CAB" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#969CAB" />
                            <TextBlock Text="{x:Bind ViewModel.CreatedAtText, Mode=OneWay}" FontSize="11.5" Foreground="#969CAB" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#1E22C55E" 
                                BorderBrush="#3322C55E" BorderThickness="1"
                                CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#22C55E" />
                                <TextBlock Text="{x:Bind ViewModel.CompatibleCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#22C55E" />
                                <TextBlock Text="{x:Bind ViewModel.CompatibleBadgeSummary, Mode=OneWay}" FontSize="11" Foreground="#22C55E" />
                            </StackPanel>
                        </Border>

                        <Border Visibility="{x:Bind ViewModel.HasIncompatible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#1EEF4444" 
                                BorderBrush="#33EF4444" BorderThickness="1"
                                CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="#EF4444" />
                                <TextBlock Text="{x:Bind ViewModel.IncompatibleCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                <TextBlock Text="{x:Bind ViewModel.IncompatibleBadgeSummary, Mode=OneWay}" FontSize="11" Foreground="#EF4444" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 1: Incompatibility Warning Banner -->
        <Border Grid.Row="1" 
                Visibility="{x:Bind ViewModel.HasIncompatible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#181B25" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" 
                        Background="#1EEF4444" BorderBrush="#33EF4444" BorderThickness="1"
                        VerticalAlignment="Top" Margin="0,2,0,0">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#1EEF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WarningBannerBadge, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.WarningBannerTitle, Mode=OneWay}" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.WarningBannerDesc, Mode=OneWay}"
                               FontSize="11.5" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Filter/Selection Quick Toolbar -->
        <Grid Grid.Row="2" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.SelectCompatibleOnlyCommand}"
                        IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource SilkSecondaryButtonStyle}" 
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#22C55E" />
                        <TextBlock Text="{x:Bind ViewModel.QuickCompatibleOnlyText, Mode=OneWay}" FontSize="11.5" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SelectAllCommand}"
                        IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource SilkSecondaryButtonStyle}" 
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#806BFF" />
                        <TextBlock Text="{x:Bind ViewModel.QuickSelectAllText, Mode=OneWay}" FontSize="11.5" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.DeselectAllCommand}"
                        IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource SilkSecondaryButtonStyle}" 
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE894;" FontSize="11" Foreground="#969CAB" />
                        <TextBlock Text="{x:Bind ViewModel.QuickDeselectAllText, Mode=OneWay}" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Counter Badge Pill -->
            <Border Grid.Column="1" Background="#202431" 
                    BorderBrush="#2B3040" BorderThickness="1"
                    CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectedLabel, Mode=OneWay}" FontSize="11" Foreground="#969CAB" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#806BFF" />
                    <TextBlock Text="/" FontSize="11" Foreground="#969CAB" />
                    <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F3F4F8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3: Tweaks Scrollable List -->
        <Border Grid.Row="3" Background="#181B25" 
                BorderBrush="#2B3040" BorderThickness="1" 
                CornerRadius="8" Padding="6" MaxHeight="400">
            <ListView ItemsSource="{x:Bind ViewModel.Tweaks}" 
                      SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetTweakItemViewModel">
                        <Border Background="#202431"
                                BorderBrush="#2B3040"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="2,2">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status / Incompatibility Icon -->
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                        Background="#181B25" BorderBrush="#2B3040" BorderThickness="1"
                                        VerticalAlignment="Top" Margin="0,1,0,0">
                                    <FontIcon Glyph="{x:Bind StatusIcon, Mode=OneWay}" 
                                              FontSize="12" Foreground="{x:Bind StatusBrush, Mode=OneWay}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Tweak Details -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <!-- Header Row: Badges and Title -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Compatibility Badge -->
                                        <Border Background="{x:Bind BadgeBackgroundBrush, Mode=OneWay}" 
                                                BorderBrush="{x:Bind StatusBrush, Mode=OneWay}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CompatibilityBadgeText, Mode=OneWay}" 
                                                       FontSize="10" FontWeight="Bold" 
                                                       Foreground="{x:Bind BadgeForegroundBrush, Mode=OneWay}" />
                                        </Border>

                                        <!-- Category Badge -->
                                        <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CategoryName, Mode=OneWay}" FontSize="10" Foreground="#969CAB" />
                                        </Border>

                                        <!-- Reboot Warning if required -->
                                        <Border Visibility="{x:Bind RequiresReboot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#1EF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                                                CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="9" Foreground="#F59E0B" />
                                                <TextBlock Text="Reboot" FontSize="9.5" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" 
                                                   Foreground="#F3F4F8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" 
                                               Foreground="#969CAB" 
                                               MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" LineHeight="16" />

                                    <!-- Incompatibility Reason Sub-panel -->
                                    <Border Visibility="{x:Bind IsIncompatible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#181B25" BorderBrush="#EF4444" BorderThickness="1"
                                            CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="11" Foreground="#EF4444" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind IncompatibilityReasonHeader, Mode=OneWay}" 
                                                           FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" />
                                                <TextBlock Text="{x:Bind IncompatibilityReason, Mode=OneWay}" 
                                                           FontSize="11" Foreground="#F3F4F8" TextWrapping="Wrap" LineHeight="15" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- AI Argument / Rationale from AI Assistant -->
                                    <Border Visibility="{x:Bind HasAiRationale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#181B25" BorderBrush="#806BFF" BorderThickness="1"
                                            CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE945;" FontSize="12" Foreground="#806BFF" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind AiRationaleHeader, Mode=OneWay}" 
                                                           FontSize="10" FontWeight="SemiBold" Foreground="#806BFF" />
                                                <TextBlock Text="{x:Bind AiRationale, Mode=OneWay}" 
                                                           FontSize="11" Foreground="#F3F4F8" TextWrapping="Wrap" LineHeight="15" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Toggle/Checkbox to include tweak -->
                                <CheckBox Grid.Column="2" 
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          MinWidth="0"
                                          VerticalAlignment="Center" Margin="8,0,2,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 4: Applying Progress Indicator -->
        <StackPanel Grid.Row="4" 
                    Visibility="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="6" Margin="0,2">
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" 
                       FontSize="11.5" Foreground="#806BFF" FontWeight="SemiBold" />
            <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" 
                         Maximum="100" Height="4" CornerRadius="2" Foreground="#806BFF" Background="#202431" />
        </StackPanel>

        <!-- 5: Dialog Buttons Footer -->
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status message when done -->
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                       FontSize="12" Foreground="#22C55E" FontWeight="SemiBold" VerticalAlignment="Center" />

            <!-- Reject Button (Secondary #181B25 with #2B3040 border) -->
            <Button Grid.Column="1" Click="RejectButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsApplying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource SilkSecondaryButtonStyle}" 
                    MinWidth="120" Margin="0,0,10,0" Padding="18,8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#F3F4F8" />
                    <TextBlock Text="{x:Bind ViewModel.RejectBtnText, Mode=OneWay}" FontSize="12.5" Foreground="#F3F4F8" />
                </StackPanel>
            </Button>

            <!-- Apply Button (Primary #806BFF) -->
            <Button Grid.Column="2" Click="ApplyButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                    Style="{StaticResource SilkPrimaryButtonStyle}" 
                    MinWidth="140" Padding="22,8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                    <TextBlock Text="{x:Bind ViewModel.ApplyBtnText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
