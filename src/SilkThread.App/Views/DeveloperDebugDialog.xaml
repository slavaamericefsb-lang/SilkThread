<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SilkThread.App.Views.DeveloperDebugDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:SilkThread.App.Helpers"
    mc:Ignorable="d"
    CornerRadius="14"
    BorderBrush="#2B3040"
    BorderThickness="1"
    Background="#181B25"
    Padding="0"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">750</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogContentMargin">0</Thickness>
    </ContentDialog.Resources>

    <Grid Width="860" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#181B25" RowSpacing="14">
        <Grid.RowDefinitions>
            <!-- 0: Header with Brand Icon, Title, and Close Button -->
            <RowDefinition Height="Auto" />
            <!-- 1: Telemetry Cards Grid (4 columns) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Terminal Box Header (label + refresh button) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Terminal Box with ScrollViewer (fills remaining space) -->
            <RowDefinition Height="*" />
            <!-- 4: Status / Confirmation Badge (Toast) -->
            <RowDefinition Height="Auto" />
            <!-- 5: Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="14" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Developer console icon (\uEBE8 in #806BFF container) -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" 
                        Background="#806BFF"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEBE8;" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Панель разработчика &amp; Отладка" FontSize="20" FontWeight="SemiBold" Foreground="#F3F4F8" />
                    <TextBlock Text="Системная телеметрия, логирование и отладка сессии" FontSize="12.5" Foreground="#969CAB" />
                </StackPanel>
            </Grid>

            <!-- Close Button (\uE711) -->
            <Button Grid.Column="1" Click="BtnClose_Click"
                    Style="{StaticResource SilkSubsurfaceButtonStyle}"
                    Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8"
                    Width="36" Height="36" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Закрыть">
                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#969CAB" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- 1: Telemetry Bar (4 clean cards in horizontal grid) -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Версия -->
            <Border Grid.Column="0" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#806BFF" />
                        <TextBlock Text="Версия" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />
                    </StackPanel>
                    <TextBlock x:Name="ChipVersionText" Text="v1.1.2 (.NET 10 x64)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card 2: Память процесса -->
            <Border Grid.Column="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE950;" FontSize="11" Foreground="#06B6D4" />
                        <TextBlock Text="Память процесса" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />
                    </StackPanel>
                    <TextBlock x:Name="ChipRamText" Text="... MB RAM" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F8" />
                </StackPanel>
            </Border>

            <!-- Card 3: Файл логов -->
            <Border Grid.Column="2" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14,10" x:Name="ChipLogBorder">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#F59E0B" />
                        <TextBlock Text="Файл логов" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />
                    </StackPanel>
                    <TextBlock x:Name="ChipLogFileText" Text="startup_debug.log" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card 4: Статус сессии -->
            <Border Grid.Column="3" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE930;" FontSize="11" Foreground="#22C55E" />
                        <TextBlock Text="Статус сессии" FontSize="11" FontWeight="SemiBold" Foreground="#969CAB" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="4" Background="#22C55E" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChipSessionStatusText" Text="Активна" FontSize="12.5" FontWeight="SemiBold" Foreground="#22C55E" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2: Terminal Box Header -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="#806BFF" />
                <TextBlock Text="Журнал работы приложения (startup_debug.log)" FontSize="12.5" FontWeight="SemiBold" Foreground="#969CAB" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="BtnRefreshLog" Grid.Column="1" Click="BtnRefreshLog_Click" 
                    Style="{StaticResource SilkSubsurfaceButtonStyle}"
                    Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6"
                    Padding="10,5" Height="30"
                    ToolTipService.ToolTip="Обновить журнал">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#806BFF" />
                    <TextBlock Text="Обновить" FontSize="11.5" Foreground="#F3F4F8" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3: Terminal Box (expanded to fill central space, ~400px) -->
        <Border Grid.Row="3" Background="#11141D" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <ScrollViewer x:Name="LogScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Enabled"
                          helpers:SmoothScroll.IsEnabled="True">
                <TextBlock x:Name="LogContentText" 
                           FontFamily="Consolas" 
                           FontSize="12" 
                           LineHeight="18"
                           Foreground="#C4B5FD" 
                           IsTextSelectionEnabled="True" 
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <!-- 4: Status / Confirmation Badge (Toast) -->
        <Border x:Name="StatusBadgeBorder" Grid.Row="4" Visibility="Collapsed" 
                Background="#162E22" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusBadgeIcon" Glyph="&#xE73E;" FontSize="13" Foreground="#22C55E" />
                    <TextBlock x:Name="StatusBadgeText" Text="Скопировано в буфер обмена!" FontSize="12.5" FontWeight="SemiBold" Foreground="#22C55E" />
                </StackPanel>
                <Button Grid.Column="1" Click="DismissStatusBadge_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#969CAB" />
                </Button>
            </Grid>
        </Border>

        <!-- 5: Bottom Action Bar -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left side: Stats badge -->
            <Border Grid.Column="0" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="#806BFF" />
                    <TextBlock x:Name="LogStatsText" Text="Строк: 0 | Размер: 0.0 КБ" FontSize="12" Foreground="#969CAB" VerticalAlignment="Center" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <!-- Right side: Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- «Сохранить логи» (Primary #806BFF, icon \uE896, MinWidth="140") -->
                <Button x:Name="BtnSaveToFile" Click="BtnSaveToFile_Click"
                        Style="{StaticResource SilkPrimaryButtonStyle}"
                        Background="#806BFF" BorderThickness="0" CornerRadius="8"
                        Height="38" MinHeight="38" MinWidth="140" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#FFFFFF" />
                        <TextBlock Text="Сохранить логи" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>

                <!-- «Копировать» (Subsurface #202431, icon \uE8C8, MinWidth="120") -->
                <Button x:Name="BtnCopyClipboard" Click="BtnCopyClipboard_Click"
                        Style="{StaticResource SilkSubsurfaceButtonStyle}"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8"
                        Height="38" MinHeight="38" MinWidth="120" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#806BFF" />
                        <TextBlock x:Name="BtnCopyClipboardText" Text="Копировать" FontSize="12.5" Foreground="#F3F4F8" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>

                <!-- «Очистить» (Subsurface #202431, icon \uE74D, MinWidth="90") -->
                <Button x:Name="BtnClearLog" Click="BtnClearLog_Click"
                        Style="{StaticResource SilkSubsurfaceButtonStyle}"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8"
                        Height="38" MinHeight="38" MinWidth="90" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                        <TextBlock Text="Очистить" FontSize="12.5" Foreground="#F3F4F8" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>

                <!-- «Закрыть» (Subsurface #202431, MinWidth="80") -->
                <Button x:Name="BtnClose" Click="BtnClose_Click"
                        Style="{StaticResource SilkSubsurfaceButtonStyle}"
                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8"
                        Height="38" MinHeight="38" MinWidth="80" Padding="16,8">
                    <TextBlock Text="Закрыть" FontSize="12.5" Foreground="#F3F4F8" TextWrapping="NoWrap" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
