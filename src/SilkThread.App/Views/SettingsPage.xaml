<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SilkThread.App.ViewModels"
    xmlns:helpers="using:SilkThread.App.Helpers"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer Background="#0E1017" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,32"
                  helpers:SmoothScroll.IsEnabled="True">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Page Title & Subtitle -->
            <StackPanel x:Name="HeaderPanel" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Two-Column Minimal Dark UI Grid -->
            <Grid ColumnSpacing="20" RowSpacing="20" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: SAFETY & AI ================= -->
                <StackPanel Grid.Column="0" Spacing="20">

                    <!-- 1. GROUP: SAFETY & SAFEGUARDS -->
                    <Border x:Name="CardSafety" Style="{StaticResource SilkCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SectionSafetyTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.SubSafetyLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#1E22C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#22C55E" />
                                        <TextBlock Text="HARDENED" FontSize="9.5" FontWeight="Bold" Foreground="#22C55E" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Setting 1: Confirm Dangerous Tweaks -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ConfirmDangerousLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.ConfirmDangerousDesc, Mode=OneWay}" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ConfirmDangerousTweaks, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Setting 2: Auto Create Restore Point -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.AutoRestoreLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.AutoRestoreDesc, Mode=OneWay}" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.AutoCreateRestorePoint, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Setting 3: Hide Incompatible Tweaks -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.HideIncompatibleLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.HideIncompatibleDesc, Mode=OneWay}" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.HideIncompatibleTweaks, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. GROUP: OPENROUTER AI PARAMETERS -->
                    <Border x:Name="CardAi" Style="{StaticResource SilkCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                        <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SectionAiTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.SubAiLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" 
                                        Background="{x:Bind ViewModel.IostStatusBadgeBg, Mode=OneWay}" 
                                        BorderBrush="{x:Bind ViewModel.IostStatusBadgeBorder, Mode=OneWay}" 
                                        BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Breathing Connection Indicator Dot -->
                                        <Grid VerticalAlignment="Center">
                                            <Border x:Name="IostStatusPulseRing" Width="14" Height="14" CornerRadius="7"
                                                    Background="{x:Bind ViewModel.IostStatusBadgeFg, Mode=OneWay}"
                                                    Opacity="0.4"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="IostStatusPulseScale" ScaleX="1.0" ScaleY="1.0" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border Width="7" Height="7" CornerRadius="3.5"
                                                    Background="{x:Bind ViewModel.IostStatusBadgeFg, Mode=OneWay}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <FontIcon Glyph="{x:Bind ViewModel.IostStatusBadgeIcon, Mode=OneWay}" 
                                                  FontSize="10" Foreground="{x:Bind ViewModel.IostStatusBadgeFg, Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.IostStatusBadgeText, Mode=OneWay}" 
                                                   FontSize="10" FontWeight="Bold" 
                                                   Foreground="{x:Bind ViewModel.IostStatusBadgeFg, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.SectionAiDesc, Mode=OneWay}" 
                                       FontSize="11.5" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" />

                            <!-- AI Setting 1: OpenRouter API Key (PasswordBox with lock toggle) -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.OpenRouterApiKeyLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.OpenRouterApiKeyDesc, Mode=OneWay}" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <PasswordBox x:Name="OpenRouterKeyBox"
                                                     Width="210"
                                                     PasswordRevealMode="Peek"
                                                     PlaceholderText="sk-..."
                                                     Background="#181B25"
                                                     BorderBrush="#2B3040"
                                                     Foreground="#F3F4F8"
                                                     CornerRadius="8"
                                                     IsEnabled="{x:Bind ViewModel.IsApiKeyUnlocked, Mode=OneWay}"
                                                     Opacity="{x:Bind ViewModel.ApiKeyBoxOpacity, Mode=OneWay}"
                                                     VerticalAlignment="Center" />
                                        <Button Command="{x:Bind ViewModel.ToggleApiKeyLockCommand}"
                                                Style="{StaticResource SilkSecondaryButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.LockTooltipText, Mode=OneWay}"
                                                Padding="10,7"
                                                MinWidth="38"
                                                Height="38"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind ViewModel.LockIcon, Mode=OneWay}" FontSize="14" Foreground="#806BFF" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AI Setting 2: Active Model Selector -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveModelLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveModelDesc, Mode=OneWay}" FontSize="11" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>

                                    <!-- Model Selector ComboBox -->
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{x:Bind ViewModel.SelectedModelIndex, Mode=TwoWay}"
                                              Background="#181B25"
                                              BorderBrush="#2B3040"
                                              Foreground="#F3F4F8"
                                              Width="260"
                                              CornerRadius="8"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="{x:Bind ViewModel.ModelItem0Label, Mode=OneWay}" />
                                        <ComboBoxItem Content="{x:Bind ViewModel.ModelItem1Label, Mode=OneWay}" />
                                        <ComboBoxItem Content="{x:Bind ViewModel.ModelItem2Label, Mode=OneWay}" />
                                        <ComboBoxItem Content="{x:Bind ViewModel.ModelItem3Label, Mode=OneWay}" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= RIGHT COLUMN: LANGUAGE & ABOUT ================= -->
                <StackPanel Grid.Column="1" Spacing="20">

                    <!-- 2. GROUP: INTERFACE LANGUAGE -->
                    <Border x:Name="CardLanguage" Style="{StaticResource SilkCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SectionLangTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.SubLangLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="RU / EN" FontSize="10" FontWeight="Bold" Foreground="#806BFF" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.SectionLangDesc, Mode=OneWay}" 
                                       FontSize="11.5" Foreground="#969CAB" />

                            <!-- Selector Tile -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.LangLabel, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.SubLangSwitchLabel, Mode=OneWay}" FontSize="10.5" Foreground="#969CAB" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" 
                                              Background="#181B25" BorderBrush="#2B3040" Foreground="#F3F4F8"
                                              Width="160" CornerRadius="8" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Русский" />
                                        <ComboBoxItem Content="English" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 4. GROUP: ABOUT SILKTHREAD & SYSTEM PLATFORM -->
                    <Border x:Name="CardAbout" Style="{StaticResource SilkCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SectionAboutTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F3F4F8" />
                                    <TextBlock Text="{x:Bind ViewModel.SubAboutLabel, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#969CAB" CharacterSpacing="50" />
                                </StackPanel>
                            </StackPanel>

                            <!-- App Branding Block -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" VerticalAlignment="Center">
                                        <Image Source="ms-appx:///Assets/Logo_SilkThread.png" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.AboutTitle, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F3F4F8" />
                                        <TextBlock Text="{x:Bind ViewModel.AboutDesc, Mode=OneWay}" FontSize="11.5" Foreground="#969CAB" TextWrapping="Wrap" LineHeight="16" />
                                        
                                        <!-- Metadata Pills -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" FontSize="10" Foreground="#806BFF" FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{x:Bind ViewModel.RuntimeEnvironment, Mode=OneWay}" FontSize="10" Foreground="#969CAB" FontFamily="Consolas" />
                                            </Border>
                                            <Border Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="SilkThread Core Team" FontSize="10" Foreground="#969CAB" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Diagnostic / Debug Version Info -->
                                        <TextBlock Text="{x:Bind ViewModel.VersionDebugInfo, Mode=OneWay}" 
                                                   FontSize="10.5" Foreground="#806BFF" FontFamily="Consolas" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Buttons: Check Updates & Update History -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Check for Updates Button -->
                                <Button x:Name="CheckUpdatesButton" Grid.Column="0"
                                        Style="{StaticResource SilkPrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="14,10"
                                        Click="CheckUpdatesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon x:Name="CheckUpdatesIcon" Glyph="&#xE895;" FontSize="13" Foreground="White" />
                                        <TextBlock x:Name="CheckUpdatesButtonText" Text="{x:Bind ViewModel.CheckUpdatesButtonText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                    </StackPanel>
                                </Button>

                                <!-- Update History / Changelog Action Button -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource SilkSecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="14,10"
                                        Click="UpdateHistoryButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="#806BFF" />
                                        <TextBlock Text="{x:Bind ViewModel.UpdateHistoryButtonText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F4F8" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Check Updates Status Text -->
                            <TextBlock x:Name="CheckUpdatesStatusText" 
                                       Visibility="Collapsed"
                                       TextAlignment="Center"
                                       FontSize="11.5" Foreground="#969CAB" 
                                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
