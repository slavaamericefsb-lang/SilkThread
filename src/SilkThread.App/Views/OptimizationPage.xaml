<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SilkThread.App.Views.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SilkThread.App.ViewModels"
    xmlns:helpers="using:SilkThread.App.Helpers"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#0E1017" Padding="28,24,28,32"
                  helpers:SmoothScroll.IsEnabled="True">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- 0: Page Title & Custom Preset Actions -->
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource SilkPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource SilkPageSubtitleStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.CreatePresetCommand}"
                            Style="{StaticResource SilkMinimalSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="#806BFF" />
                            <TextBlock Text="{x:Bind ViewModel.CreatePresetLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ActivatePresetCommand}"
                            Style="{StaticResource SilkMinimalSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#806BFF" />
                            <TextBlock Text="{x:Bind ViewModel.ActivatePresetLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1: Minimal Dark Grid Layout -->
            <Grid ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: PROFILES & EXECUTION ================= -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- CARD 1: 4 Optimization Profiles -->
                    <Border x:Name="CardProfiles" Style="{StaticResource SilkMinimalCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- Card Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="15" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind ViewModel.ProfilesCardTitle, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <TextBlock Text="{x:Bind ViewModel.ProfilesCardSubtitle, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="60" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ProfilesCountBadge, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#806BFF" />
                                </Border>
                            </Grid>

                            <!-- 4 Profile Cards GridView -->
                            <GridView ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedProfileIndex, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="False">
                                <GridView.Resources>
                                    <!-- Clean transparent selection items without default blue wash -->
                                    <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemCheckThemeBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemCheckBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemCheckBoxBrush" Color="Transparent" />
                                </GridView.Resources>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OptimizationPreset">
                                        <Grid Width="254" Height="142">
                                            <!-- Card Background Surface (#181B25, Border #2B3040 1px, CornerRadius 12) -->
                                            <Border CornerRadius="12" Background="#181B25" BorderBrush="#2B3040" BorderThickness="1" Padding="14,12">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Top: Icon, Badge and Radio Marker -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Width="30" Height="30" CornerRadius="6" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                                                <FontIcon Glyph="{x:Bind Icon}" FontSize="13" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Badge}" FontSize="9" FontWeight="Bold" Foreground="#806BFF" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Custom Radio Marker (#806BFF) -->
                                                        <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center">
                                                            <!-- Inactive radio circle -->
                                                            <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#2B3040" BorderThickness="1.5" Background="Transparent" />
                                                            <!-- Active radio marker -->
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="#806BFF" BorderBrush="#806BFF" BorderThickness="1.5"
                                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Title -->
                                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                                    <!-- Description -->
                                                    <TextBlock Grid.Row="2" Text="{x:Bind Description}" FontSize="11" Foreground="#94A3B8" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="15" />
                                                </Grid>
                                            </Border>

                                            <!-- Profile Cards Selected Border with Smooth Transition & Glow -->
                                            <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="#806BFF" 
                                                    Opacity="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToGlowOpacityConverter}}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Execution Controller & Options -->
                    <Border x:Name="CardExecution" Style="{StaticResource SilkMinimalCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                        <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind ViewModel.ControlCardTitle, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <TextBlock Text="{x:Bind ViewModel.ControlCardSubtitle, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="60" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#10B981" />
                                        <TextBlock Text="{x:Bind ViewModel.ProtectionActiveBadge, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Safeguard Restore Point Option Block (ToggleSwitch #806BFF) -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <Grid VerticalAlignment="Center" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CreateRestorePointLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                        <TextBlock Text="{x:Bind ViewModel.RestorePointSubtitle, Mode=OneWay}" FontSize="12" Foreground="#969CAB" />
                                    </StackPanel>

                                    <!-- WinUI 3 ToggleSwitch with custom #806BFF accent colors -->
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.CreateRestorePoint, Mode=TwoWay}"
                                                  OnContent="" OffContent=""
                                                  MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0">
                                        <ToggleSwitch.Resources>
                                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#806BFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9382FF" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6C55FF" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#806BFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#9382FF" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6C55FF" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                </Grid>
                            </Border>

                            <!-- Selected Profile Summary -->
                            <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedProfilePrefix, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPreset.Name, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#806BFF" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ProgressTotal, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#806BFF" />
                                        <TextBlock Text="{x:Bind ViewModel.TweaksCountSuffix, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Start Optimization Button (Primary #806BFF, Height 40px, CornerRadius 8px) -->
                            <Button Command="{x:Bind ViewModel.StartOptimizationCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsExecuting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    CornerRadius="8"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#806BFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#9382FF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6C55FF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#202431" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#64748B" />
                                    <SolidColorBrush x:Key="ButtonBorderThemeBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderThemeBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderThemeBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderThemeBrushDisabled" Color="Transparent" />
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.StartBtnLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Progress & Status (Thin ProgressBar #806BFF) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" 
                                           FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" 
                                             Maximum="100" Height="4" CornerRadius="2">
                                    <ProgressBar.Resources>
                                        <SolidColorBrush x:Key="ProgressBarForeground" Color="#806BFF" />
                                        <SolidColorBrush x:Key="ProgressBarBackground" Color="#202431" />
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ================= RIGHT COLUMN: LIVE TERMINAL ================= -->
                <Border x:Name="CardTerminal" Grid.Column="1" Style="{StaticResource SilkMinimalCardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#202431" BorderBrush="#2B3040" BorderThickness="1">
                                    <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#806BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind ViewModel.ExecutionLogTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock Text="{x:Bind ViewModel.AuditSubtitle, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="60" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.ClearLogsCommand}" 
                                        Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="{x:Bind ViewModel.ClearLogsLabel, Mode=OneWay}" FontSize="11" Foreground="#CBD5E1" />
                                    </StackPanel>
                                </Button>

                                <!-- Terminal Live Badge with Pulsing Emerald Glow -->
                                <Border Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <!-- Pulsing emerald aura when live / executing -->
                                            <Border x:Name="TerminalLiveGlow" Width="10" Height="10" CornerRadius="5"
                                                    Background="#10B981" Opacity="0.45"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="TerminalLiveScale" ScaleX="1.0" ScaleY="1.0" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <!-- Core live emerald dot -->
                                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Status Metrics -->
                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.ProgressHeader, Mode=OneWay}" Style="{StaticResource SilkSectionHeaderStyle}" FontSize="8" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.ProgressCurrent, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#806BFF" />
                                        <TextBlock Text="/" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ProgressTotal, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#202431" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SystemStatusHeader, Mode=OneWay}" Style="{StaticResource SilkSectionHeaderStyle}" FontSize="8" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Live Terminal Container (#11141D, Border #2B3040, Consolas font) -->
                        <Border Grid.Row="2" Background="#11141D" BorderBrush="#2B3040" BorderThickness="1" CornerRadius="10" Padding="14" MinHeight="390">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Terminal Window Bar -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" />
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" />
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="silkthread-audit ~ powershell/registry" FontSize="11" FontFamily="Consolas" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TerminalCursor" Text="█" FontSize="11" FontFamily="Consolas" Foreground="#10B981" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Real-time Log Stream -->
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ExecutionLog}" SelectionMode="None"
                                          helpers:SmoothScroll.IsEnabled="True">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontSize="11" FontFamily="Consolas" Foreground="#CBD5E1" Margin="0,2" TextWrapping="Wrap" LineHeight="16" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
